!META!
    $mode speed
    $asm allowed
    $unsafe rawptr

    $define %type int32 as integer
        bits: 32
        signed: true
        from: {-2147483648}
        to: {2147483647}

    $define %type uint8 as integer
        bits: 8
        signed: false
        from: {0}
        to: {255}

    $define %type char as character
        bits: 8
        signed: true
        encoding: ascii

    $define %const VGA_BASE as 753664
    $define %const VGA_COLS as 80
    $define %const VGA_ROWS as 25
    $define %const VGA_ATTR as 15

    $define %func vga_putc as function
        args: { c: char, pos: int32 }
        returns: void
        pure: false
        allocates: false
        recurses: false

    $define %func vga_clear as function
        args: { void }
        returns: void
        pure: false
        allocates: false
        recurses: false

    $define %func vga_print as function
        args: { ptr: rawptr, len: int32 }
        returns: void
        pure: false
        allocates: false
        recurses: false

    $define %func serial_putc as function
        args: { c: char }
        returns: void
        pure: false
        allocates: false
        recurses: false

    $define %func main as start
        args: { void }
        returns: void
        pure: false
        allocates: false
        recurses: false

    $space %export main, vga_putc, vga_clear, vga_print, serial_putc
!END!

func vga_putc(c: char, pos: int32) {
    let mut vga: rawptr = 753664;
    let idx: int32 = pos * 2;
    vga[idx] = c;
    let attr_idx: int32 = pos * 2 + 1;
    vga[attr_idx] = 15;
}

func vga_clear() {
    let mut vga: rawptr = 753664;
    let mut i: int32 = 0;
    while i < 2000 {
        vga[i * 2] = 32;
        vga[i * 2 + 1] = 15;
        i = i + 1;
    }
}

func vga_print(ptr: rawptr, len: int32) {
    let mut i: int32 = 0;
    while i < len {
        vga_putc(ptr[i], i);
        i = i + 1;
    }
}

func serial_putc(c: char) {
    asm {
        inputs { c: "m" }
        clobbers { "eax", "edx", "memory" }
        mov $0x3F8, %%edx
        movzbl %0, %%eax
        out %%al, (%%dx)
    }
}

func main() {
    vga_clear();

    vga_putc('o', 0);
    vga_putc('k', 1);

    while 1 {
        asm {
            hlt
        }
    }
}
