!META!
    $mode safety
    $bounds static
    $overflow checked
    $null_check always
    $div_check always
    $init zero
    $thread single
    $complexity max(15)
    $panic halt
    $range_check always

    $c_include stdio.h
    $c_include stdlib.h
    $c_include string.h

    $c_func printf as c_function
        header: stdio.h
        returns: int
        args: { const char*, ... }

    $c_func fgets as c_function
        header: stdio.h
        returns: char*
        args: { char*, int, void* }

    $c_func srand as c_function
        header: stdlib.h
        returns: void
        args: { unsigned int }

    $c_func rand as c_function
        header: stdlib.h
        returns: int
        args: { void }

    $c_func time as c_function
        header: stdlib.h
        returns: long
        args: { void* }
    $c_include time.h
    $c_include stdint.h

    $define %type int32 as integer
        bits: 32
        signed: true
        from: {-2147483648}
        to: {2147483647}

    $define %type uint32 as integer
        bits: 32
        signed: false
        from: {0}
        to: {4294967295}

    $define %type int64 as integer
        bits: 64
        signed: true
        from: {-9223372036854775808}
        to: {9223372036854775807}

    $define %type float64 as float
        bits: 64
        encoding: ieee754
        precision: double

    $define %type bool as boolean
        bits: 8
        true_value: {1}
        false_value: {0}

    $define %type char8 as character
        bits: 8
        signed: true
        encoding: ascii

    $let MAX_GUESSES = 10
    $let BUFFER_SIZE = 64

    $assert { MAX_GUESSES > 0 }
    $assert { MAX_GUESSES <= 100 }
    $assert { BUFFER_SIZE > 0 }

    $define %const MAX_GUESSES = { 10 }
    $define %const BUFFER_SIZE = { 64 }

    $define %type GameState as struct
        layout: aos
        fields: {
            secret: int32,
            guesses: int32[ MAX_GUESSES ],
            guess_count: int32,
            max_guesses: int32,
            won: bool,
            game_over: bool
        }
        max_count_field: guess_count
        capacity: { MAX_GUESSES }

    $define %func main as start
        args: { void }
        returns: int32
        allocates: false
        recurses: false

    $define %func game_init as procedure
        args: { state: GameState* }
        returns: void
        pure: false
        mutates: { state }
        complexity: max(5)
        allocates: false
        recurses: false

    $define %func game_generate_secret as procedure
        args: { state: GameState* }
        returns: void
        pure: false
        mutates: { state }
        complexity: max(5)
        allocates: false
        recurses: false

    $define %func game_make_guess as function
        args: { state: GameState*, guess: int32 }
        returns: int32
        pure: false
        mutates: { state }
        complexity: max(10)
        allocates: false
        recurses: false

    $define %func game_is_won as function
        args: { state: GameState* }
        returns: bool
        pure: true
        complexity: max(5)
        allocates: false
        recurses: false

    $define %func game_is_over as function
        args: { state: GameState* }
        returns: bool
        pure: true
        complexity: max(5)
        allocates: false
        recurses: false

    $define %func game_get_remaining_guesses as function
        args: { state: GameState* }
        returns: int32
        pure: true
        complexity: max(5)
        allocates: false
        recurses: false

    $define %func read_int as function
        args: { out_value: int32* }
        returns: bool
        pure: false
        mutates: { out_value }
        complexity: max(10)
        allocates: false
        recurses: false

    $define %func display_welcome as procedure
        args: { void }
        returns: void
        pure: false
        allocates: false
        recurses: false

    $define %func display_guess_result as procedure
        args: { guess: int32, secret: int32, remaining: int32 }
        returns: void
        pure: false
        allocates: false
        recurses: false

    $define %func display_game_over as procedure
        args: { state: GameState* }
        returns: void
        pure: false
        mutates: { state }
        allocates: false
        recurses: false

    $define %func display_guess_history as procedure
        args: { state: GameState* }
        returns: void
        pure: false
        mutates: { state }
        allocates: false
        recurses: false

    $space %export main, GameState, game_init, game_generate_secret, game_make_guess,
        game_is_won, game_is_over, game_get_remaining_guesses, read_int,
        display_welcome, display_guess_result, display_game_over, display_guess_history
!END!

const MAX_GUESSES: int = 10;
const BUFFER_SIZE: int = 64;

struct GameState {
    int secret;
    int guesses[MAX_GUESSES];
    int guess_count;
    int max_guesses;
    bool won;
    bool game_over;
}

func game_init(state: mut GameState) -> void {
    map (i in 0..MAX_GUESSES) {
        state.guesses[i] = 0;
    }
    state.guess_count = 0;
    state.max_guesses = MAX_GUESSES;
    state.won = false;
    state.game_over = false;
    game_generate_secret(state);
}

func game_generate_secret(state: mut GameState) -> void {
    c.srand(c.time(0));
    state.secret = (c.rand() % 100) + 1;  // 1..100
}

func game_make_guess(state: mut GameState, guess: int32) -> int32 {
    // Возвращает: 1 = слишком мало, 2 = слишком много, 3 = угадано, -1 = ошибка
    
    if state.game_over {
        return -1;
    }
    
    if state.guess_count >= state.max_guesses {
        state.game_over = true;
        return -1;
    }
    
    if guess < 1 || guess > 100 {
        return -1;
    }
    
    state.guesses[state.guess_count] = guess;
    state.guess_count = state.guess_count + 1;
    
    if guess == state.secret {
        state.won = true;
        state.game_over = true;
        return 3;
    }
    
    if guess < state.secret {
        return 1;  // too low
    }
    
    if state.guess_count >= state.max_guesses {
        state.game_over = true;
    }
    
    return 2;  // too high
}

func game_is_won(state: GameState) -> bool {
    state.won
}

func game_is_over(state: GameState) -> bool {
    state.game_over
}

func game_get_remaining_guesses(state: GameState) -> int32 {
    state.max_guesses - state.guess_count
}

func read_int(out_value: mut int32) -> bool {
    let mut buffer: char8[BUFFER_SIZE];
    let mut i = 0;
    let mut negative = false;
    let mut value = 0;
    
    if c.fgets(&buffer[0], BUFFER_SIZE, c.stdin) == 0 {
        return false;
    }
    
    // Пропускаем пробелы
    while buffer[i] == ' ' || buffer[i] == '\t' || buffer[i] == '\n' {
        i = i + 1;
    }
    
    if buffer[i] == '-' {
        negative = true;
        i = i + 1;
    }
    
    if buffer[i] < '0' || buffer[i] > '9' {
        return false;
    }
    
    while buffer[i] >= '0' && buffer[i] <= '9' {
        value = value * 10 + (buffer[i] - '0');
        i = i + 1;
    }
    
    if negative {
        value = -value;
    }
    
    out_value = value;
    true
}

func display_welcome() -> void {
    c.printf("\n========================================\n");
    c.printf("🎯  GUESS THE NUMBER  🎯\n");
    c.printf("========================================\n");
    c.printf("I'm thinking of a number between 1 and 100.\n");
    c.printf("You have %d guesses to find it!\n", MAX_GUESSES);
    c.printf("----------------------------------------\n\n");
}

func display_guess_result(guess: int32, secret: int32, remaining: int32) -> void {
    if guess == secret {
        c.printf("🎉 CORRECT! The number was %d!\n", secret);
        c.printf("   You have %d guesses remaining.\n", remaining);
        return;
    }
    
    if guess < secret {
        c.printf("📈 Too low!  (guesses remaining: %d)\n", remaining);
    } else {
        c.printf("📉 Too high! (guesses remaining: %d)\n", remaining);
    }
}

func display_guess_history(state: mut GameState) -> void {
    c.printf("\n📋 Guess history:\n");
    c.printf("   ");
    map (i in 0..state.guess_count) {
        c.printf("%d ", state.guesses[i]);
    }
    c.printf("\n\n");
}

func display_game_over(state: mut GameState) -> void {
    c.printf("\n========================================\n");
    if state.won {
        c.printf("🏆  YOU WON! 🏆\n");
        c.printf("   The number was %d\n", state.secret);
        c.printf("   You found it in %d guesses!\n", state.guess_count);
    } else {
        c.printf("💀  GAME OVER  💀\n");
        c.printf("   The number was %d\n", state.secret);
        c.printf("   You ran out of guesses!\n");
    }
    c.printf("========================================\n\n");
}

func main() -> int32 {
    let mut state: GameState = {0};
    let mut guess: int32 = 0;
    let mut result: int32 = 0;
    let mut valid_input = false;
    let mut skip_turn = false;
    let mut stop_game = false;
    
    game_init(&state);
    display_welcome();
    
    while !game_is_over(state) && !stop_game {
        display_guess_history(&state);
        
        c.printf("Enter your guess (1-100): ");
        valid_input = read_int(&guess);
        
        skip_turn = false;
        
        if !valid_input {
            c.printf("❌ Invalid input! Game stopped.\n");
            stop_game = true;
        }
        
        if !skip_turn {
            if guess < 1 || guess > 100 {
                c.printf("❌ Guess must be between 1 and 100!\n");
                skip_turn = true;
            }
        }
        
        if !skip_turn {
            result = game_make_guess(&state, guess);
            
            if result == -1 {
                c.printf("❌ Error! Game is over.\n");
                stop_game = true;
            }
        }
        
        if !skip_turn && !stop_game {
            let remaining = game_get_remaining_guesses(state);
            display_guess_result(guess, state.secret, remaining);
            
            if game_is_won(state) {
                stop_game = true;
            }
        }
    }
    
    display_game_over(&state);
    return 0;
}