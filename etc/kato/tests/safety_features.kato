!META!
    $mode safety
    $layout soa
    $bounds static
    $overflow checked
    $init zero
    $null_check always
    $div_check always
    $alloc static
    $thread single
    $complexity max(10)
    $panic abort
    $range_check always

    $c_include stdio.h
    $c_include stdlib.h

    $c_func printf as c_function
        header: stdio.h
        returns: int
        args: { const char*, ... }

    $c_func abort as c_function
        header: stdlib.h
        returns: void
        args: { void }

    $let MAX_VAL = 100

    $assert { MAX_VAL > 0 }
    $assert { MAX_VAL <= 1000 }

    $define %type int32 as integer
        bits: 32
        signed: true
        from: {-100}
        to: {100}

    $define %type bool as boolean
        bits: 8
        true_value: {1}
        false_value: {0}

    $define %type DataStore as struct
        layout: soa
        fields: {
            values: int32[ MAX_VAL ],
            count: int32
        }
        max_count_field: count
        capacity: { MAX_VAL }

    $define %const MAX_VAL = { 100 }

    $define %func main as start
        args: { void }
        returns: int32

    $define %func store_add as function
        args: { store: DataStore*, val: int32 }
        returns: bool
        pure: false
        mutates: { store }
        complexity: max(8)
        allocates: false
        recurses: false

    $define %func store_sum as function
        args: { store: DataStore* }
        returns: int32
        pure: true
        complexity: max(8)
        allocates: false

    $define %func store_divide as function
        args: { store: DataStore*, divisor: int32 }
        returns: int32
        pure: false
        mutates: { store }
        complexity: max(8)
        allocates: false

    $define %func safe_add as function
        args: { a: int32, b: int32 }
        returns: int32
        pure: true
        complexity: max(5)

    $space %export main, DataStore, store_add, store_sum, store_divide, safe_add
!END!

const MAX_VAL: int = 100;

struct DataStore {
    int values[MAX_VAL];
    int count;
}

func safe_add(a: int, b: int) -> int {
    a + b
}

func store_add(store: mut DataStore, val: int) -> bool {
    if store.count >= MAX_VAL {
        return false;
    }
    let idx = store.count;
    store.values[idx] = val;
    store.count = idx + 1;
    true
}

func store_sum(store: DataStore) -> int {
    fold (0, i in 0..store.count) {
        acc + store.values[i]
    }
}

func store_divide(store: mut DataStore, divisor: int) -> int {
    let mut total = 0;
    map (i in 0..store.count) {
        store.values[i] = store.values[i] / divisor;
        total = total + store.values[i];
    }
    total
}

func main() -> int {
    let mut store: DataStore = {0};
    
    store_add(&store, 10);
    store_add(&store, 20);
    store_add(&store, 30);
    
    let sum = store_sum(store);
    c.printf("sum = %d\n", sum);
    
    let divided = store_divide(&store, 10);
    c.printf("divided sum = %d\n", divided);
    
    let x = safe_add(50, 50);
    c.printf("50 + 50 = %d\n", x);
    
    return 0;
}
