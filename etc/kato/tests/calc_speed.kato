!META!
    $mode speed
    $c_include stdio.h
    $c_include stdlib.h
    $c_include string.h

    $c_func printf as c_function
        header: stdio.h
        returns: int
        args: { const char*, ... }

    $c_func fgets as c_function
        header: stdio.h
        returns: char*
        args: { char*, int, void* }

    $define %type int32 as integer
        bits: 32
        signed: true
        from: {-2147483648}
        to: {2147483647}

    $define %type float64 as float
        bits: 64
        encoding: ieee754
        precision: double

    $define %type bool as boolean
        bits: 8
        true_value: {1}
        false_value: {0}

    $define %type char8 as character
        bits: 8
        signed: true
        encoding: ascii

    $define %func main as start
        args: { void }
        returns: int32
        allocates: false
        recurses: false

    $define %func calculator_run as function
        args: { void }
        returns: int32
        pure: false
        allocates: false
        recurses: false

    $define %func parse_number as function
        args: { input: char8*, out_value: float64* }
        returns: int32
        pure: false
        mutates: { out_value }
        allocates: false
        recurses: false

    $define %func perform_op as function
        args: { op: char8, a: float64, b: float64, result: float64* }
        returns: bool
        pure: false
        mutates: { result }
        allocates: false
        recurses: false

    $define %func display_result as procedure
        args: { result: float64 }
        returns: void
        pure: false
        allocates: false

    $space %export main, calculator_run, parse_number, perform_op, display_result
!END!

func parse_number(input: char*, out_value: mut double) -> int {
    let mut value: double = 0.0;
    let mut i = 0;
    let mut sign = 1.0;
    let mut found_digit = false;

    while input[i] == ' ' || input[i] == '\t' {
        i = i + 1;
    }

    if input[i] == '-' {
        sign = -1.0;
        i = i + 1;
    }

    while input[i] >= '0' && input[i] <= '9' {
        value = value * 10.0 + (input[i] - '0');
        i = i + 1;
        found_digit = true;
    }

    if input[i] == '.' {
        i = i + 1;
        let mut frac: double = 0.1;
        while input[i] >= '0' && input[i] <= '9' {
            value = value + (input[i] - '0') * frac;
            frac = frac * 0.1;
            i = i + 1;
            found_digit = true;
        }
    }

    if !found_digit {
        return 0;
    }

    out_value = sign * value;
    i
}

func perform_op(op: char, a: double, b: double, result: mut double) -> bool {
    if op == '+' {
        result = a + b;
        return true;
    }
    if op == '-' {
        result = a - b;
        return true;
    }
    if op == '*' {
        result = a * b;
        return true;
    }
    if op == '/' {
        if b == 0.0 {
            return false;
        }
        result = a / b;
        return true;
    }
    if op == '%' {
        if b == 0.0 {
            return false;
        }
        result = a - b * (a / b);
        return true;
    }
    false
}

func display_result(result: double) -> void {
    c.printf("Result: %g\n", result);
}

func calculator_run() -> int {
    let mut input: char[256];
    let mut a: double = 0.0;
    let mut b: double = 0.0;
    let mut op: char = '+';
    let mut result: double = 0.0;
    let mut pos = 0;
    let mut ok = false;

    c.printf("Kato Calculator (speed mode)\n");
    c.printf("Enter expression (e.g. 2 + 3): ");

    if c.fgets(&input[0], 256, c.stdin) == 0 {
        return 1;
    }

    pos = parse_number(&input[0], &a);
    if pos == 0 {
        c.printf("Error: invalid first number\n");
        return 1;
    }

    while input[pos] == ' ' {
        pos = pos + 1;
    }

    op = input[pos];
    pos = pos + 1;

    while input[pos] == ' ' {
        pos = pos + 1;
    }

    pos = parse_number(&input[pos], &b);
    if pos == 0 {
        c.printf("Error: invalid second number\n");
        return 1;
    }

    ok = perform_op(op, a, b, &result);
    if !ok {
        c.printf("Error: invalid operation or division by zero\n");
        return 1;
    }

    display_result(result);
    0
}

func main() -> int {
    calculator_run()
}
