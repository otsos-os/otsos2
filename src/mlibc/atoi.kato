!META!
    $mode speed

    $define %func atoi as function
        args: { str: char* }
        returns: int
        pure: true
        allocates: false
        recurses: false

    $space %export atoi
!END!

func atoi(str: char*) -> int {
    let mut result: int = 0;
    let mut sign: int = 1;
    let mut i: int = 0;

    if str[i] == '-' {
        sign = -1;
        i = i + 1;
    }

    while str[i] >= '0' && str[i] <= '9' {
        result = result * 10 + (str[i] - '0');
        i = i + 1;
    }

    return sign * result;
}
