+
+#ifndef KERNEL_DRIVERS_DISK_NVME_NVME_H
+#define KERNEL_DRIVERS_DISK_NVME_NVME_H
+
+#include <kernel/drivers/disk/bio.h>
+#include <kernel/drivers/disk/disk.h>
+#include <kernel/drivers/disk/nvme/nvmereg.h>
+#include <kernel/drivers/newbus/newbus.h>
+#include <kernel/mm/dma/dma.h>
+#include <kernel/mm/vm/vm_page.h>
+#include <kernel/pci/pci.h>
+#include <kernel/sync/sync.h>
+#include <mlibc/mlibc.h>
+
+#define	NVME_MAX_CONTROLLERS	4
+#define	NVME_MAX_NAMESPACES	8
+
+/*
+ * Ceiling on I/O queues, and therefore on vectors: one for admin plus one per
+ * I/O queue.  Each queue costs its SQ, CQ and a PRP list page per slot, so at
+ * the default depth this is a few megabytes of DMA memory per controller --
+ * that cost, not the hardware, is what caps it here.  NVME_MAX_VECTORS must
+ * stay within NEWBUS_MAX_MSI_ENTRIES or the bus runs out of resources before
+ * the driver runs out of queues, and the driver then quietly gets fewer.
+ */
+#define	NVME_MAX_IO_QUEUES	8
+#define	NVME_MAX_VECTORS	(NVME_MAX_IO_QUEUES + 1)
+
+_Static_assert(NVME_MAX_VECTORS <= NEWBUS_MAX_MSI_ENTRIES,
+    "NVMe wants more MSI-X entries than the bus will hand out");
+
+/*
+ * Admin depth is small because attach-time Identify and queue creation are
+ * the only traffic it carries; I/O depth is a runtime knob because the
+ * controller's MQES is the real ceiling and a host that wants fewer slots
+ * should not have to recompile.
+ */
+#define	NVME_ADMIN_QDEPTH		32
+#define	NVME_IO_QDEPTH_DEFAULT		64
+#define	NVME_IO_QDEPTH_MIN		2
+#define	NVME_IO_QDEPTH_MAX		256
+
+/*
+ * One PRP list page holds PAGE_SIZE / 8 entries.  PRP1 names the first
+ * segment, the list names the rest, so a transfer of this many pages never
+ * needs a chained list.  A buffer that starts mid-page of this size spans
+ * one extra page, which is why the DMA tag's nsegments is this plus one.
+ */
+#define	NVME_MAX_XFER_PAGES		512
+#define	NVME_PRP_ENTRIES_PER_PAGE	(PAGE_SIZE / 8)
+
+#define	NVME_TR_F_BUSY		0x01
+#define	NVME_TR_F_COMPLETE	0x02
+#define	NVME_TR_F_MAPPED	0x04
+
+/*
+ * Five seconds is far more than Identify or Create Queue needs and short
+ * enough that a dead controller does not stall boot.  CAP.TO is a different
+ * clock, used only for CSTS.RDY.
+ */
+#define	NVME_ADMIN_TIMEOUT_NS		5000000000ULL
+#define	NVME_RESET_TIMEOUT_FLOOR_NS	2000000000ULL
+
+/*
+ * nanouptime() returns a constant zero until the timecounter is running, so
+ * a pure deadline loop would never exit.  This budget is the backstop: at
+ * a few nanoseconds per pause it is many seconds of spinning, long enough
+ * for a live controller and finite enough for a dead one.
+ */
+#define	NVME_SPIN_BUDGET		2000000000ULL
+
+#define	NVME_PCI_CLASS		0x01
+#define	NVME_PCI_SUBCLASS	0x08
+#define	NVME_PCI_PROGIF		0x02
+#define	NVME_BAR_MIN		0x2000
+
+struct nvme_ctrl;
+struct nvme_queue;
+
+typedef struct nvme_tracker {
+	dma_map_t		map;
+	struct bio		*bio;
+	struct nvme_queue	*queue;
+	void			*prp_virt;
+	u64			prp_phys;
+	u64			submit_ns;
+	u32			cdw0;
+	u16			cid;
+	u16			status;
+	u8			flags;
+	u8			opc;
+	u16			pad;
+} nvme_tracker_t;
+
+typedef struct nvme_queue {
+	spin_t			lock;
+	struct nvme_ctrl	*ctrl;
+	dma_mem_t		sq_mem;
+	dma_mem_t		cq_mem;
+	dma_mem_t		prp_mem;
+	nvme_tracker_t		*trackers;
+	u16			*free_cids;
+	volatile u32		*sq_tdbl;
+	volatile u32		*cq_hdbl;
+	u32			qdepth;
+	u32			sq_tail;
+	u32			cq_head;
+	/*
+	 * MSI-X vector this CQ was told to raise, as passed in Create I/O CQ
+	 * CDW11.  Recorded because the controller silently keeps using it: a
+	 * queue recreated after reset must name the same vector, otherwise its
+	 * completions arrive on a handler that does not look at this queue.
+	 */
+	u16			cq_vector;
+	u16			qid;
+	u8			phase;
+	u8			created;
+	u32			free_count;
+	u64			nsubmit;
+	u64			ncomplete;
+	u64			fail_busy;
+	u64			fail_prp;
+} nvme_queue_t;
+
+typedef struct nvme_ns {
+	disk_t			disk;
+	struct nvme_ctrl	*ctrl;
+	u64			nsze;
+	u32			nsid;
+	u32			lba_size;
+	u8			registered;
+	u8			pad[7];
+} nvme_ns_t;
+
+/*
+ * What one ISR needs to know.  `queue` is the queue whose CQ this vector was
+ * told to signal, or NULL when the vector is shared and the handler has to
+ * sweep every queue instead.  Passing the controller alone was enough while
+ * there was one vector; with several, a handler that sweeps all queues on each
+ * one turns N vectors back into N times the work of one.
+ */
+typedef struct nvme_irq {
+	struct nvme_ctrl	*ctrl;
+	struct nvme_queue	*queue;
+	/*
+	 * `res` is what was allocated and must be released; `intr_res` is what
+	 * the handler actually sits on.  They differ when MSI programming failed
+	 * and the bus moved the handler to the shared INTx line: tearing down
+	 * with the wrong one of the two is refused and leaves the handler live.
+	 */
+	resource_t		*res;
+	resource_t		*intr_res;
+	void			*cookie;
+	u32			entry;
+	u8			is_msi;
+	u8			pad[3];
+	u64			ncall;
+} nvme_irq_t;
+
+typedef struct nvme_ctrl {
+	volatile u8		*regs;
+	pci_device_t		*pci;
+	device_t		nb_dev;
+	dma_tag_t		tag;
+	dma_tag_t		q_tag;
+	dma_tag_t		prp_tag;
+	dma_tag_t		xfer_tag;
+	nvme_queue_t		admin_q;
+	nvme_queue_t		io_q[NVME_MAX_IO_QUEUES];
+	nvme_irq_t		irq[NVME_MAX_VECTORS];
+	nvme_ns_t		ns[NVME_MAX_NAMESPACES];
+	dma_mem_t		id_mem;
+	u64			cap;
+	u32			ns_count;
+	u32			nioq;
+	/*
+	 * Queues that have both DMA memory and a vector binding -- the most that
+	 * can ever run.  A reset renegotiates from here rather than from the
+	 * current count, otherwise a controller that once granted fewer would
+	 * hold the driver at that number for the rest of the boot.
+	 */
+	u32			nioq_max;
+	u32			nirq;
+	u32			mps;
+	u32			dstrd;
+	u32			max_xfer;
+	u32			qdepth;
+	u16			cntlid;
+	u8			vwc;
+	u8			irq_msi;
+	u8			irq_shared;
+	u8			resetting;
+	u8			failed;
+	u8			unit;
+	char			model[NVME_MODEL_LEN + 1];
+	char			serial[NVME_SERIAL_LEN + 1];
+	u64			nreset;
+	u64			nfail_status;
+} nvme_ctrl_t;
+
+/*
+ * A completion pulled out of the CQ under the queue lock so bio_done() can
+ * run after the lock is dropped.  bio_done() may call back into submit, and
+ * taking the queue lock from inside itself is a deadlock.
+ */
+typedef struct nvme_done {
+	struct bio		*bio;
+	int			status;
+	u32			resid;
+} nvme_done_t;
+
+u64		nvme_now_ns(void);
+u64		nvme_deadline_ns(u64 timeout_ns);
+int		nvme_wait_expired(u64 deadline_ns, u64 *spins);
+
+u32		nvme_reg32(const nvme_ctrl_t *ctrl, u32 off);
+void		nvme_reg32_set(nvme_ctrl_t *ctrl, u32 off, u32 value);
+u64		nvme_reg64(const nvme_ctrl_t *ctrl, u32 off);
+void		nvme_reg64_set(nvme_ctrl_t *ctrl, u32 off, u64 value);
+
+int		nvme_queue_init(nvme_ctrl_t *ctrl, nvme_queue_t *q,
+		    u16 qid, u32 qdepth);
+void		nvme_queue_fini(nvme_queue_t *q);
+void		nvme_queue_reset(nvme_queue_t *q);
+u32		nvme_queue_service(nvme_queue_t *q);
+void		nvme_queue_flush_inflight(nvme_queue_t *q, int status);
+nvme_tracker_t	*nvme_tracker_get(nvme_queue_t *q);
+void		nvme_tracker_put(nvme_queue_t *q, nvme_tracker_t *tr);
+int		nvme_prp_build(nvme_tracker_t *tr, u64 *prp1, u64 *prp2);
+int		nvme_admin_cmd(nvme_ctrl_t *ctrl, nvme_sqe_t *sqe,
+		    u32 *cdw0, u16 *status);
+
+int		nvme_submit(disk_t *disk, bio_t *bio);
+int		nvme_timeout(disk_t *disk, bio_t *bio);
+int		nvme_intr(void *arg);
+
+int		nvme_ctrl_disable(nvme_ctrl_t *ctrl);
+int		nvme_ctrl_enable(nvme_ctrl_t *ctrl);
+int		nvme_ctrl_reset(nvme_ctrl_t *ctrl);
+int		nvme_identify(nvme_ctrl_t *ctrl);
+int		nvme_ns_attach(nvme_ctrl_t *ctrl);
+void		nvme_ns_detach(nvme_ctrl_t *ctrl);
+int		nvme_ioq_create(nvme_ctrl_t *ctrl);
+int		nvme_ioq_delete(nvme_ctrl_t *ctrl);
+nvme_queue_t	*nvme_queue_for_bio(nvme_ctrl_t *ctrl);
+
+#endif
