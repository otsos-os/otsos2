diff --git a/libc/LibAudio/Makefile b/libc/LibAudio/Makefile
new file mode 100644
index 0000000..8a8361e
--- /dev/null
+++ b/libc/LibAudio/Makefile
@@ -0,0 +1,34 @@
+TARGET ?= x86_64-elf
+CC ?= clang
+AR ?= llvm-ar
+
+ROOT = ../..
+NATIVE_DIR = $(ROOT)/libc/native
+TARGET_CFLAGS ?= --target=$(TARGET)
+CFLAGS ?= $(TARGET_CFLAGS) -ffreestanding -fPIE -fno-stack-protector \
+	-nostdlib -nostdinc -fno-builtin -O2 -Wall -Wextra \
+	-Iinclude -I$(NATIVE_DIR)/include
+
+LIB = lib/libaudio.a
+SRC = src/enumerate.c src/stream.c src/buffer.c src/format.c
+OBJ = $(SRC:src/%.c=build/%.o)
+HDR = include/libaudio.h src/private.h
+
+.PHONY: all clean
+
+all: $(LIB)
+
+$(LIB): $(OBJ)
+	@mkdir -p lib
+	@echo "  AR       $@"
+	@rm -f $@
+	@$(AR) rcs $@ $(OBJ)
+
+build/%.o: src/%.c $(HDR)
+	@mkdir -p $(dir $@)
+	@echo "  CC       $<"
+	@$(CC) $(CFLAGS) -c $< -o $@
+
+clean:
+	rm -rf build
+	rm -f $(LIB)
