+
+#ifndef KERNEL_DRIVERS_DISK_BIO_H
+#define KERNEL_DRIVERS_DISK_BIO_H
+
+#include <kernel/drivers/disk/disk.h>
+#include <mlibc/mlibc.h>
+
+/*
+ * One block request.  The path is asynchronous at its core: bio_submit() hands
+ * the request to the driver and returns, and the driver calls bio_done() from
+ * wherever completion actually happens — a completion-queue interrupt for NVMe,
+ * inline for a RAM disk.  bio_read()/bio_write() are ordinary callers of that
+ * same path that then sleep on the request, so there is exactly one submission
+ * mechanism in the kernel and the synchronous case has no private route.
+ *
+ * A bio belongs to its submitter until bio_submit() returns 0; from then until
+ * the callback fires it belongs to the driver, and nobody may touch its fields.
+ */
+
+#define	BIO_READ	1
+#define	BIO_WRITE	2
+#define	BIO_FLUSH	3
+
+/*
+ * Status codes.  Negative so a status can be returned directly as an error and
+ * 0 stays the single success value; bio_status_name() turns one into text,
+ * because "I/O error" with no distinction between a dead device, a rejected
+ * request and a timeout is the report that costs an hour at 3am.
+ */
+#define	BIO_STATUS_OK		0
+#define	BIO_STATUS_IOERR	(-1)
+#define	BIO_STATUS_TIMEOUT	(-2)
+#define	BIO_STATUS_INVAL	(-3)
+#define	BIO_STATUS_NODEV	(-4)
+#define	BIO_STATUS_NOMEM	(-5)
+#define	BIO_STATUS_MEDIUM	(-6)
+#define	BIO_STATUS_READONLY	(-7)
+#define	BIO_STATUS_UNSUPP	(-8)
+
+/*
+ * Set by bio_submit() once the request is in flight and cleared by bio_done().
+ * A driver must not set either; they exist so double submission and double
+ * completion are caught at the boundary instead of corrupting a queue.
+ */
+#define	BIO_F_INFLIGHT		0x0001
+#define	BIO_F_DONE		0x0002
+
+/*
+ * 30 seconds.  Long enough that a slow spinning device under load does not get
+ * killed, short enough that a wedged controller does not hang the caller for
+ * the rest of uptime.  A device with a real per-command deadline should pass
+ * its own value to bio_wait() rather than lean on this.
+ */
+#define	BIO_TIMEOUT_DEFAULT_NS	30000000000ULL
+
+typedef void	(*bio_done_fn)(struct bio *bio);
+
+typedef struct bio {
+	disk_t		*disk;
+	void		*buf;
+	/* Scratch for the owning driver: command slot, tracker, DMA map. The
+	 * block layer never reads it. */
+	void		*driver_priv;
+	bio_done_fn	done;
+	void		*done_arg;
+	u64		lba;
+	u64		submit_ns;
+	u32		nsectors;
+	/* Sectors NOT transferred.  0 on success; a short transfer reports the
+	 * remainder here instead of pretending the whole request landed. */
+	u32		resid;
+	u32		cmd;
+	u32		flags;
+	int		status;
+	int		pad;
+} bio_t;
+
+typedef struct bio_stat {
+	u64	submits;
+	u64	completions;
+	u64	reads;
+	u64	writes;
+	u64	flushes;
+	u64	sectors_read;
+	u64	sectors_written;
+	u64	inflight;
+	u64	inflight_peak;
+	u64	fail_inval;
+	u64	fail_nodev;
+	u64	fail_io;
+	u64	fail_timeout;
+	u64	fail_readonly;
+	u64	short_transfers;
+} bio_stat_t;
+
+void		bio_init(bio_t *bio, disk_t *disk, u32 cmd);
+int		bio_submit(bio_t *bio);
+void		bio_done(bio_t *bio, int status, u32 resid);
+int		bio_wait(bio_t *bio, u64 timeout_ns);
+
+int		bio_read(disk_t *disk, u64 lba, u32 nsectors, void *buf);
+int		bio_write(disk_t *disk, u64 lba, u32 nsectors, const void *buf);
+int		bio_flush(disk_t *disk);
+
+const char	*bio_status_name(int status);
+void		bio_stats(bio_stat_t *out);
+void		bio_dump(void);
+
+#endif
