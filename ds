+static int
+hda_map_bar(hda_softc_t *sc)
+{
+	int	rid;
+
+	if (sc == NULL || sc->dev == NULL) {
+		return (-1);
+	}
+	rid = 0;
+	sc->mem_res = bus_alloc_resource(sc->dev, SYS_RES_MEMORY, &rid,
+	    0, 0, RF_ACTIVE);
+	if (sc->mem_res == NULL) {
+		drivers_log("[HDA] failed to map BAR0\n");
+		return (-1);
+	}
+	sc->mmio = (void *)(sc->mem_res->start + DMAP_BASE);
+	return (0);
+}
