+/*
+ * Queue id 0 is the admin pair, so I/O queues start at 1.  Vector 0 always
+ * carries admin: the admin CQ's vector is fixed by CC/AQA rather than named in
+ * a command, and the controller uses the first message for it.
+ */
+#define	NVME_IOQ_ID_BASE	1
+#define	NVME_ADMIN_VECTOR	0
+#define	NVME_MDTS_UNLIMITED	0
+#define	NVME_DRIVER_NAME	"nvme"
