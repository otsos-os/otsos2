+/*
+ * Turn an NVMe status field into a block layer status.  Media errors are told
+ * apart from everything else because they mean the data is gone rather than
+ * the request was wrong, and a filesystem reacts differently to the two.
+ */
+static int
+nvme_status_to_bio(u16 status)
+{
+	u32	sct, sc;
+
+	sct = (status >> NVME_STATUS_SCT_SHIFT) & NVME_STATUS_SCT_MASK;
+	sc = (status >> NVME_STATUS_SC_SHIFT) & NVME_STATUS_SC_MASK;
+
+	if (sct == NVME_SCT_GENERIC && sc == NVME_SC_SUCCESS) {
+		return (BIO_STATUS_OK);
+	}
+	if (sct == NVME_SCT_MEDIA) {
+		switch (sc) {
+		case NVME_SC_WRITE_FAULT:
+		case NVME_SC_UNRECOVERED_READ:
+		case NVME_SC_GUARD_CHECK_ERROR:
+		case NVME_SC_APPTAG_CHECK_ERROR:
+		case NVME_SC_REFTAG_CHECK_ERROR:
+			return (BIO_STATUS_MEDIUM);
+		default:
+			return (BIO_STATUS_IOERR);
+		}
+	}
+	if (sct == NVME_SCT_GENERIC) {
+		switch (sc) {
+		case NVME_SC_LBA_OUT_OF_RANGE:
+		case NVME_SC_CAPACITY_EXCEEDED:
+		case NVME_SC_INVALID_FIELD:
+			return (BIO_STATUS_INVAL);
+		case NVME_SC_INVALID_OPCODE:
+			return (BIO_STATUS_UNSUPP);
+		case NVME_SC_ABORTED_BY_REQUEST:
+		case NVME_SC_ABORTED_SQ_DELETION:
+			return (BIO_STATUS_TIMEOUT);
+		default:
+			return (BIO_STATUS_IOERR);
+		}
+	}
+	return (BIO_STATUS_IOERR);
+}
+
+static nvme_sqe_t *
+nvme_sqe_slot(nvme_queue_t *q, u32 index)
+{
+	return (&((nvme_sqe_t *)q->sq_mem.virt)[index]);
+}
+
+static nvme_cqe_t *
+nvme_cqe_slot(nvme_queue_t *q, u32 index)
+{
+	return (&((nvme_cqe_t *)q->cq_mem.virt)[index]);
+}
+
+int
+nvme_queue_init(nvme_ctrl_t *ctrl, nvme_queue_t *q, u16 qid, u32 qdepth)
+{
+	nvme_tracker_t	*tr;
+	u64		stride, sq_bytes, cq_bytes, prp_bytes;
+	u32		i;
+
+	if (ctrl == NULL || q == NULL || qdepth < 2) {
+		return (-1);
+	}
+	memset(q, 0, sizeof(*q));
+	q->ctrl = ctrl;
+	q->qid = qid;
+	q->qdepth = qdepth;
+	q->phase = 1;
+	spin_init(&q->lock, qid == 0 ? "nvme-admin" : "nvme-io", LO_NVME);
+
+	sq_bytes = (u64)qdepth * NVME_SQE_SIZE;
+	cq_bytes = (u64)qdepth * NVME_CQE_SIZE;
+	prp_bytes = (u64)qdepth * PAGE_SIZE;
+
+	if (dma_mem_alloc(ctrl->q_tag, sq_bytes, DMA_F_NOWAIT,
+	    &q->sq_mem) != 0) {
+		goto fail;
+	}
+	if (dma_mem_alloc(ctrl->q_tag, cq_bytes, DMA_F_NOWAIT,
+	    &q->cq_mem) != 0) {
+		goto fail;
+	}
+	/*
+	 * One contiguous run sliced per command slot, rather than a page each:
+	 * the slices are page aligned because the run is, and a PRP list must
+	 * be page aligned.  One allocation also means one failure point.
+	 */
+	if (dma_mem_alloc(ctrl->prp_tag, prp_bytes, DMA_F_NOWAIT,
+	    &q->prp_mem) != 0) {
+		goto fail;
+	}
+	q->trackers = kmem_calloc(qdepth, sizeof(*q->trackers));
+	if (q->trackers == NULL) {
+		goto fail;
+	}
+	q->free_cids = kmem_calloc(qdepth, sizeof(*q->free_cids));
+	if (q->free_cids == NULL) {
+		goto fail;
+	}
+	for (i = 0; i < qdepth; i++) {
+		tr = &q->trackers[i];
+		tr->queue = q;
+		tr->cid = (u16)i;
+		tr->prp_virt = (u8 *)q->prp_mem.virt + ((u64)i * PAGE_SIZE);
+		tr->prp_phys = q->prp_mem.phys + ((u64)i * PAGE_SIZE);
+		/*
+		 * The map is created here and never in the submit path, because
+		 * dma_map_create() allocates and submit can run from a context
+		 * that must not.  dma_map_load() itself allocates nothing.
+		 */
+		if (dma_map_create(ctrl->xfer_tag, DMA_F_NOWAIT,
+		    &tr->map) != 0) {
+			goto fail;
+		}
+		q->free_cids[i] = (u16)i;
+	}
+	q->free_count = qdepth;
+
+	stride = 4ULL << ctrl->dstrd;
+	q->sq_tdbl = (volatile u32 *)(ctrl->regs + NVME_DBL_BASE +
+	    ((u64)qid * 2ULL) * stride);
+	q->cq_hdbl = (volatile u32 *)(ctrl->regs + NVME_DBL_BASE +
+	    (((u64)qid * 2ULL) + 1ULL) * stride);
+	return (0);
+fail:
+	nvme_queue_fini(q);
+	return (-1);
+}
+
+void
+nvme_queue_fini(nvme_queue_t *q)
+{
+	u32	i;
+
+	if (q == NULL) {
+		return;
+	}
+	if (q->trackers != NULL) {
+		for (i = 0; i < q->qdepth; i++) {
+			/*
+			 * Unload before destroy: a map still holding bounce
+			 * pages would leak them back to nobody, and the pool
+			 * is finite.
+			 */
+			if ((q->trackers[i].flags & NVME_TR_F_MAPPED) != 0) {
+				dma_map_unload(&q->trackers[i].map);
+			}
+			dma_map_destroy(&q->trackers[i].map);
+		}
+		kmem_free(q->trackers);
+		q->trackers = NULL;
+	}
+	if (q->free_cids != NULL) {
+		kmem_free(q->free_cids);
+		q->free_cids = NULL;
+	}
+	dma_mem_free(&q->prp_mem);
+	dma_mem_free(&q->cq_mem);
+	dma_mem_free(&q->sq_mem);
+	q->free_count = 0;
+	q->created = 0;
+}
+
+/*
+ * Put a queue back to the state the controller expects right after it is
+ * created: empty rings, phase 1, every slot free.  Called on the reset path,
+ * where the caller has already made sure nothing is in flight.
+ */
+void
+nvme_queue_reset(nvme_queue_t *q)
+{
+	u32	i;
+
+	if (q == NULL) {
+		return;
+	}
+	q->sq_tail = 0;
+	q->cq_head = 0;
+	q->phase = 1;
+	if (q->sq_mem.virt != NULL) {
+		memset(q->sq_mem.virt, 0, q->sq_mem.size);
+	}
+	if (q->cq_mem.virt != NULL) {
+		memset(q->cq_mem.virt, 0, q->cq_mem.size);
+	}
+	if (q->trackers == NULL || q->free_cids == NULL) {
+		return;
+	}
+	for (i = 0; i < q->qdepth; i++) {
+		q->trackers[i].bio = NULL;
+		q->trackers[i].flags = 0;
+		q->trackers[i].status = 0;
+		q->trackers[i].cdw0 = 0;
+		q->free_cids[i] = (u16)i;
+	}
+	q->free_count = q->qdepth;
+}
+
+/* Queue lock held. */
+nvme_tracker_t *
+nvme_tracker_get(nvme_queue_t *q)
+{
+	nvme_tracker_t	*tr;
+	u16		cid;
+
+	if (q->free_count == 0) {
+		return (NULL);
+	}
+	q->free_count--;
+	cid = q->free_cids[q->free_count];
+	tr = &q->trackers[cid];
+	tr->flags = NVME_TR_F_BUSY;
+	tr->bio = NULL;
+	tr->status = 0;
+	tr->cdw0 = 0;
+	tr->submit_ns = nvme_now_ns();
+	return (tr);
+}
+
+/* Queue lock held. */
+void
+nvme_tracker_put(nvme_queue_t *q, nvme_tracker_t *tr)
+{
+	if (tr == NULL || (tr->flags & NVME_TR_F_BUSY) == 0) {
+		return;
+	}
+	tr->flags = 0;
+	tr->bio = NULL;
+	q->free_cids[q->free_count] = tr->cid;
+	q->free_count++;
+}
+
+/*
+ * Finish the DMA side of a completed tracker: copy any bounce pages back,
+ * then release them.  Queue lock held, which is why the sync and unload run
+ * here rather than after the lock is dropped -- LO_DMA is above LO_NVME, so
+ * this direction is the legal one.
+ */
+static void
+nvme_tracker_release(nvme_tracker_t *tr)
+{
+	if ((tr->flags & NVME_TR_F_MAPPED) == 0) {
+		return;
+	}
+	if (tr->opc == NVME_NVM_READ) {
+		dma_sync(&tr->map, DMA_SYNC_POSTREAD);
+	} else {
+		dma_sync(&tr->map, DMA_SYNC_POSTWRITE);
+	}
+	dma_map_unload(&tr->map);
+	tr->flags &= (u8)~NVME_TR_F_MAPPED;
+}
+
+/*
+ * Drain completions into the caller's batch.  Queue lock held.  Admin
+ * completions have no bio: they are recorded on the tracker and the poller
+ * in nvme_admin_cmd() picks them up, so both interrupt and polled paths go
+ * through this one function and neither can miss a CQE the other consumed.
+ *
+ * Returns the number of CQEs consumed; *ndone counts the subset that need a
+ * bio_done() once the lock is dropped.
+ */
+static u32
+nvme_cq_drain(nvme_queue_t *q, nvme_done_t *done, u32 *ndone)
+{
+	nvme_tracker_t	*tr;
+	nvme_cqe_t	*cqe;
+	u32		consumed, resid;
+	u16		status;
+	int		bstatus;
+
+	consumed = 0;
+	*ndone = 0;
+	for (;;) {
+		if (*ndone >= NVME_DONE_BATCH) {
+			break;
+		}
+		cqe = nvme_cqe_slot(q, q->cq_head);
+		status = cqe->status;
+		if ((status & NVME_STATUS_PHASE) != q->phase) {
+			break;
+		}
+		/*
+		 * A CID outside the pool means the controller answered a
+		 * command we never sent.  Consuming the entry keeps the ring
+		 * moving; touching trackers[cid] would corrupt memory.
+		 */
+		if (cqe->cid >= q->qdepth) {
+			drivers_log("[NVME] q%u: completion for unknown cid "
+			    "%u\n", q->qid, cqe->cid);
+			q->ctrl->nfail_status++;
+		} else {
+			tr = &q->trackers[cqe->cid];
+			if ((tr->flags & NVME_TR_F_BUSY) == 0) {
+				/* Duplicate completion: ignore, do not free a
+				 * slot that may already be reused. */
+				drivers_log("[NVME] q%u: completion for idle "
+				    "cid %u\n", q->qid, cqe->cid);
+				q->ctrl->nfail_status++;
+			} else {
+				tr->status = status;
+				tr->cdw0 = cqe->cdw0;
+				tr->flags |= NVME_TR_F_COMPLETE;
+				bstatus = nvme_status_to_bio(status);
+				if (bstatus != BIO_STATUS_OK) {
+					q->ctrl->nfail_status++;
+				}
+				if (tr->bio != NULL) {
+					nvme_tracker_release(tr);
+					resid = bstatus == BIO_STATUS_OK ? 0 :
+					    tr->bio->nsectors;
+					done[*ndone].bio = tr->bio;
+					done[*ndone].status = bstatus;
+					done[*ndone].resid = resid;
+					(*ndone)++;
+					nvme_tracker_put(q, tr);
+				}
+				q->ncomplete++;
+			}
+		}
+		q->cq_head++;
+		if (q->cq_head == q->qdepth) {
+			q->cq_head = 0;
+			q->phase ^= 1;
+		}
+		consumed++;
+	}
+	if (consumed != 0) {
+		*q->cq_hdbl = q->cq_head;
+	}
+	return (consumed);
+}
+
+/*
+ * Drain one queue and complete whatever came out.  bio_done() runs with the
+ * lock dropped because it invokes a caller supplied callback that is free to
+ * submit again, and re-entering the queue lock from there would deadlock a
+ * CPU with interrupts already off.
+ */
+u32
+nvme_queue_service(nvme_queue_t *q)
+{
+	nvme_done_t	done[NVME_DONE_BATCH];
+	u32		consumed, total, ndone, i;
+
+	if (q == NULL || q->cq_mem.virt == NULL) {
+		return (0);
+	}
+	total = 0;
+	for (;;) {
+		spin_lock(&q->lock);
+		consumed = nvme_cq_drain(q, done, &ndone);
+		spin_unlock(&q->lock);
+		for (i = 0; i < ndone; i++) {
+			bio_done(done[i].bio, done[i].status, done[i].resid);
+		}
+		total += consumed;
+		/* A short drain means the ring is empty; a full batch means
+		 * there may be more behind it. */
+		if (ndone < NVME_DONE_BATCH) {
+			break;
+		}
+	}
+	return (total);
+}
+
+int
+nvme_intr(void *arg)
+{
+	nvme_ctrl_t	*ctrl;
+	nvme_irq_t	*irq;
+	u32		handled, i;
+
+	irq = arg;
+	if (irq == NULL || irq->ctrl == NULL) {
+		return (-1);
+	}
+	ctrl = irq->ctrl;
+	irq->ncall++;
+	/*
+	 * A dedicated vector was told which CQ it signals, so it drains that one
+	 * and nothing else -- sweeping every queue on every vector would undo
+	 * the point of having several.  The binding is one to one and fixed at
+	 * probe: nvme_irq_alloc() either gives every queue its own vector or
+	 * puts all of them on one, never a mix.
+	 */
+	if (irq->queue != NULL) {
+		handled = nvme_queue_service(irq->queue);
+		return (handled != 0 || irq->is_msi != 0 ? 0 : -1);
+	}
+	/*
+	 * Shared vector: everything lands here.  Draining admin is not an
+	 * optimisation -- on a level triggered legacy line an undrained admin
+	 * CQE holds the line asserted and the machine livelocks in the handler.
+	 */
+	handled = nvme_queue_service(&ctrl->admin_q);
+	for (i = 0; i < ctrl->nioq; i++) {
+		handled += nvme_queue_service(&ctrl->io_q[i]);
+	}
+	if (handled == 0 && ctrl->irq_msi == 0) {
+		return (-1);
+	}
+	return (0);
+}
+
+/*
+ * Build PRP1 and PRP2 from the loaded segment list.  The xfer tag carries
+ * boundary = PAGE_SIZE, so segments never cross a page: the first may hold an
+ * offset, every later one starts page aligned, which is exactly what PRP
+ * requires.  Everything is checked anyway -- a tag edited later is the way
+ * this rots, and a wrong PRP list transfers the wrong bytes with a success
+ * status, which is worse than a rejected command.
+ */
+int
+nvme_prp_build(nvme_tracker_t *tr, u64 *prp1, u64 *prp2)
+{
+	const dma_seg_t	*segs;
+	u64		*list;
+	u32		nsegs, i, mps;
+
+	mps = tr->queue->ctrl->mps;
+	segs = dma_map_segs(&tr->map, &nsegs);
+	if (segs == NULL || nsegs == 0) {
+		return (-1);
+	}
+	for (i = 1; i < nsegs; i++) {
+		if ((segs[i].phys & ((u64)mps - 1)) != 0) {
+			drivers_log("[NVME] PRP seg %u not page aligned: "
+			    "0x%llx\n", i, (unsigned long long)segs[i].phys);
+			return (-1);
+		}
+	}
+	for (i = 0; i + 1 < nsegs; i++) {
+		if ((segs[i].phys + segs[i].len) % (u64)mps != 0) {
+			drivers_log("[NVME] PRP seg %u does not end on a page "
+			    "boundary: 0x%llx+%llu\n", i,
+			    (unsigned long long)segs[i].phys,
+			    (unsigned long long)segs[i].len);
+			return (-1);
+		}
+	}
+	*prp1 = segs[0].phys;
+	if (nsegs == 1) {
+		*prp2 = 0;
+		return (0);
+	}
+	if (nsegs == 2) {
+		*prp2 = segs[1].phys;
+		return (0);
+	}
+	if (nsegs - 1 > NVME_PRP_ENTRIES_PER_PAGE) {
+		drivers_log("[NVME] %u segments exceed one PRP list page\n",
+		    nsegs);
+		return (-1);
+	}
+	list = tr->prp_virt;
+	for (i = 1; i < nsegs; i++) {
+		list[i - 1] = segs[i].phys;
+	}
+	*prp2 = tr->prp_phys;
+	return (0);
+}
+
+/* Queue lock held.  Copies the entry in, then publishes the new tail. */
+static void
+nvme_sq_ring(nvme_queue_t *q, const nvme_sqe_t *sqe)
+{
+	nvme_sqe_t	*slot;
+
+	slot = nvme_sqe_slot(q, q->sq_tail);
+	memcpy(slot, sqe, sizeof(*sqe));
+	q->sq_tail++;
+	if (q->sq_tail == q->qdepth) {
+		q->sq_tail = 0;
+	}
+	/*
+	 * The entry must be visible before the doorbell tells the controller
+	 * to read it.  On x86 stores to WB memory are ordered, but the doorbell
+	 * is a device write and the compiler is free to sink the memcpy past it
+	 * without this.
+	 */
+	__atomic_thread_fence(__ATOMIC_RELEASE);
+	*q->sq_tdbl = q->sq_tail;
+	q->nsubmit++;
+}
+
+/*
+ * Issue one admin command and wait for it.  Polled rather than interrupt
+ * driven, because the first callers run before the handler is wired and the
+ * reset path runs with the vector masked.  Both still go through
+ * nvme_cq_drain(), so an interrupt that arrives anyway cannot steal the CQE.
+ */
+int
+nvme_admin_cmd(nvme_ctrl_t *ctrl, nvme_sqe_t *sqe, u32 *cdw0, u16 *status)
+{
+	nvme_queue_t	*q;
+	nvme_tracker_t	*tr;
+	nvme_done_t	done[NVME_DONE_BATCH];
+	u64		deadline, spins;
+	u32		ndone;
+	u16		cid, cqe_status;
+	int		complete;
+
+	if (ctrl == NULL || sqe == NULL) {
+		return (-1);
+	}
+	q = &ctrl->admin_q;
+	spin_lock(&q->lock);
+	tr = nvme_tracker_get(q);
+	if (tr == NULL) {
+		q->fail_busy++;
+		spin_unlock(&q->lock);
+		return (-1);
+	}
+	cid = tr->cid;
+	tr->opc = sqe->opc;
+	sqe->cid = cid;
+	nvme_sq_ring(q, sqe);
+	spin_unlock(&q->lock);
+
+	deadline = nvme_deadline_ns(NVME_ADMIN_TIMEOUT_NS);
+	spins = 0;
+	for (;;) {
+		spin_lock(&q->lock);
+		(void)nvme_cq_drain(q, done, &ndone);
+		complete = (q->trackers[cid].flags & NVME_TR_F_COMPLETE) != 0;
+		spin_unlock(&q->lock);
+		if (complete) {
+			break;
+		}
+		if (nvme_wait_expired(deadline, &spins)) {
+			/*
+			 * The slot is deliberately not returned to the free
+			 * list.  The controller may still write a CQE for this
+			 * CID, and handing the CID out again would let that
+			 * late completion land on an unrelated command.  The
+			 * caller resets the controller, which is what makes the
+			 * slot safe to reuse.
+			 */
+			drivers_log("[NVME] admin opcode 0x%x cid %u timed "
+			    "out\n", sqe->opc, cid);
+			return (-1);
+		}
+		__asm__ volatile("pause");
+	}
+
+	/*
+	 * Copy the result out before the slot goes back on the free list: past
+	 * that point another CPU may take the same CID and overwrite it.
+	 */
+	spin_lock(&q->lock);
+	tr = &q->trackers[cid];
+	cqe_status = tr->status;
+	if (cdw0 != NULL) {
+		*cdw0 = tr->cdw0;
+	}
+	nvme_tracker_put(q, tr);
+	spin_unlock(&q->lock);
+
+	if (status != NULL) {
+		*status = cqe_status;
+	}
+	if (nvme_status_to_bio(cqe_status) != BIO_STATUS_OK) {
+		drivers_log("[NVME] admin opcode 0x%x failed: sct=%u sc=0x%x\n",
+		    sqe->opc, (cqe_status >> NVME_STATUS_SCT_SHIFT) &
+		    NVME_STATUS_SCT_MASK,
+		    (cqe_status >> NVME_STATUS_SC_SHIFT) &
+		    NVME_STATUS_SC_MASK);
+		return (-1);
+	}
+	return (0);
+}
+
+/*
+ * Pick the I/O queue this CPU submits on.  Steering by CPU rather than by LBA
+ * is what keeps the queue lock uncontended in the common case: each CPU stays
+ * on its own queue, so two CPUs submitting at once do not serialise on one
+ * spinlock.  With fewer queues than CPUs the modulo shares them, which is
+ * still better than one.
+ *
+ * smp_cpu_index() can report -1 before the per-CPU areas are attached, so the
+ * negative case falls back to queue 0 instead of indexing out of the array.
+ */
+nvme_queue_t *
+nvme_queue_for_bio(nvme_ctrl_t *ctrl)
+{
+	int	cpu;
+	u32	nioq, idx;
+
+	/*
+	 * Loaded once.  A reset running concurrently rewrites nioq, and reading
+	 * it twice could pass the zero check and then divide by the new zero.
+	 * A stale non-zero value is harmless: the queue it selects either has
+	 * created == 0 and the submit is rejected, or it is live and usable.
+	 */
+	nioq = __atomic_load_n(&ctrl->nioq, __ATOMIC_ACQUIRE);
+	if (nioq == 0) {
+		return (NULL);
+	}
+	cpu = smp_cpu_index();
+	idx = cpu < 0 ? 0U : (u32)cpu % nioq;
+	return (&ctrl->io_q[idx]);
+}
+
+int
+nvme_submit(disk_t *disk, bio_t *bio)
+{
+	nvme_ctrl_t	*ctrl;
+	nvme_queue_t	*q;
+	nvme_tracker_t	*tr;
+	nvme_ns_t	*ns;
+	nvme_sqe_t	sqe;
+	u64		prp1, prp2, len;
+	u32		dflags;
+
+	if (disk == NULL || bio == NULL || disk->private_data == NULL) {
+		return (-1);
+	}
+	ns = disk->private_data;
+	ctrl = ns->ctrl;
+	/*
+	 * Reject rather than queue while the controller is down.  Returning
+	 * negative leaves the bio uncompleted and owned by the caller, which
+	 * is the contract; completing it here would race the reset path that
+	 * is completing everything in flight.
+	 */
+	if (ctrl->failed != 0 || ctrl->resetting != 0) {
+		return (-1);
+	}
+	q = nvme_queue_for_bio(ctrl);
+	if (q == NULL || q->created == 0) {
+		return (-1);
+	}
+
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.nsid = ns->nsid;
+	switch (bio->cmd) {
+	case BIO_READ:
+		sqe.opc = NVME_NVM_READ;
+		break;
+	case BIO_WRITE:
+		sqe.opc = NVME_NVM_WRITE;
+		break;
+	case BIO_FLUSH:
+		sqe.opc = NVME_NVM_FLUSH;
+		break;
+	default:
+		return (-1);
+	}
+
+	spin_lock(&q->lock);
+	tr = nvme_tracker_get(q);
+	if (tr == NULL) {
+		q->fail_busy++;
+		spin_unlock(&q->lock);
+		return (-1);
+	}
+	tr->bio = bio;
+	tr->opc = sqe.opc;
+	bio->driver_priv = tr;
+	sqe.cid = tr->cid;
+
+	if (bio->cmd != BIO_FLUSH) {
+		len = (u64)bio->nsectors * (u64)ns->lba_size;
+		dflags = DMA_F_NOWAIT | (bio->cmd == BIO_READ ? DMA_F_READ :
+		    DMA_F_WRITE);
+		if (dma_map_load(&tr->map, bio->buf, len, dflags) != 0) {
+			nvme_tracker_put(q, tr);
+			spin_unlock(&q->lock);
+			return (-1);
+		}
+		tr->flags |= NVME_TR_F_MAPPED;
+		if (nvme_prp_build(tr, &prp1, &prp2) != 0) {
+			q->fail_prp++;
+			dma_map_unload(&tr->map);
+			tr->flags &= (u8)~NVME_TR_F_MAPPED;
+			nvme_tracker_put(q, tr);
+			spin_unlock(&q->lock);
+			return (-1);
+		}
+		/*
+		 * PREWRITE copies the caller's data into any bounce page before
+		 * the controller can read it.  PREREAD is issued for a read so
+		 * a partially completed transfer cannot leave the bounce page
+		 * holding a previous command's bytes.
+		 */
+		dma_sync(&tr->map, bio->cmd == BIO_WRITE ? DMA_SYNC_PREWRITE :
+		    DMA_SYNC_PREREAD);
+		sqe.prp1 = prp1;
+		sqe.prp2 = prp2;
+		sqe.cdw10 = (u32)(bio->lba & 0xFFFFFFFFULL);
+		sqe.cdw11 = (u32)(bio->lba >> 32);
+		/* NLB is zero based: one block is encoded as 0. */
+		sqe.cdw12 = (u32)(bio->nsectors - 1) & 0xFFFFU;
+	}
+	nvme_sq_ring(q, &sqe);
+	spin_unlock(&q->lock);
+	return (0);
+}
+
+/*
+ * Complete everything in flight on a queue with one status.  Queue lock is
+ * taken and dropped inside, and the bios are finished after it is dropped.
+ * Used by the reset path, which has already stopped the controller, so no
+ * CQE can arrive for these slots afterwards.
+ */
+void
+nvme_queue_flush_inflight(nvme_queue_t *q, int status)
+{
+	nvme_done_t	done[NVME_DONE_BATCH];
+	nvme_tracker_t	*tr;
+	u32		ndone, i;
+
+	if (q == NULL || q->trackers == NULL) {
+		return;
+	}
+	for (;;) {
+		ndone = 0;
+		spin_lock(&q->lock);
+		for (i = 0; i < q->qdepth && ndone < NVME_DONE_BATCH; i++) {
+			tr = &q->trackers[i];
+			if ((tr->flags & NVME_TR_F_BUSY) == 0 ||
+			    tr->bio == NULL) {
+				continue;
+			}
+			nvme_tracker_release(tr);
+			done[ndone].bio = tr->bio;
+			done[ndone].status = status;
+			done[ndone].resid = tr->bio->nsectors;
+			ndone++;
+			nvme_tracker_put(q, tr);
+		}
+		spin_unlock(&q->lock);
+		for (i = 0; i < ndone; i++) {
+			bio_done(done[i].bio, done[i].status, done[i].resid);
+		}
+		if (ndone == 0) {
+			break;
+		}
+	}
+}
+
+/*
+ * A command overran its deadline.  Try the cheap thing first -- ask the
+ * controller to abort it and give the CQE a moment to land -- and fall back to
+ * a controller reset, which is the only way to make the CID safe to reuse when
+ * the controller is not answering at all.
+ *
+ * Returning 0 promises bio_done() will run for this bio; returning negative
+ * says the request could not be cancelled and bio_wait() keeps waiting.  The
+ * one case that must return negative is a bio that is already gone, because
+ * then there is nothing left to take responsibility for.
+ */
+int
+nvme_timeout(disk_t *disk, bio_t *bio)
+{
+	nvme_ctrl_t	*ctrl;
+	nvme_queue_t	*q;
+	nvme_tracker_t	*tr;
+	nvme_sqe_t	sqe;
+	nvme_ns_t	*ns;
+	u64		deadline, spins;
+	u16		cid;
+	int		inflight;
+
+	if (disk == NULL || bio == NULL || disk->private_data == NULL) {
+		return (-1);
+	}
+	ns = disk->private_data;
+	ctrl = ns->ctrl;
+	/*
+	 * The bio remembers its tracker, and a tracker's queue is assigned once
+	 * at queue init and never reassigned -- so this read needs no lock even
+	 * if the slot was recycled meanwhile.  Which bio owns the slot is the
+	 * part that changes, and that is checked below under that queue's lock.
+	 * Guessing a queue instead would abort a CID on the wrong SQ.
+	 */
+	tr = bio->driver_priv;
+	if (tr == NULL || tr->queue == NULL || tr->queue->ctrl != ctrl) {
+		return (-1);
+	}
+	q = tr->queue;
+
+	spin_lock(&q->lock);
+	tr = bio->driver_priv;
+	inflight = 0;
+	if (tr != NULL && tr->queue == q && tr->bio == bio &&
+	    (tr->flags & NVME_TR_F_BUSY) != 0) {
+		inflight = 1;
+		cid = tr->cid;
+	} else {
+		cid = 0;
+	}
+	spin_unlock(&q->lock);
+
+	if (inflight == 0) {
+		/* Completed while the deadline was expiring; bio_wait() will
+		 * see DONE on its next pass. */
+		return (-1);
+	}
+	if (ctrl->resetting != 0) {
+		/* A reset already under way will complete this bio. */
+		return (-1);
+	}
+
+	drivers_log("[NVME] %s: command cid %u timed out, aborting\n",
+	    disk->name, cid);
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_ABORT;
+	sqe.cdw10 = ((u32)cid << 16) | (u32)q->qid;
+	if (nvme_admin_cmd(ctrl, &sqe, NULL, NULL) == 0) {
+		deadline = nvme_deadline_ns(NVME_ABORT_SETTLE_NS);
+		spins = 0;
+		for (;;) {
+			(void)nvme_queue_service(q);
+			if ((__atomic_load_n(&bio->flags, __ATOMIC_ACQUIRE) &
+			    BIO_F_DONE) != 0) {
+				return (0);
+			}
+			if (nvme_wait_expired(deadline, &spins)) {
+				break;
+			}
+			__asm__ volatile("pause");
+		}
+	}
+
+	/*
+	 * Abort did not land.  Reset, which completes every outstanding request
+	 * including this one.  If the reset itself fails the controller is
+	 * marked dead and the requests are still completed, so the promise made
+	 * by returning 0 holds either way.
+	 */
+	drivers_log("[NVME] %s: abort ineffective, resetting controller\n",
+	    disk->name);
+	(void)nvme_ctrl_reset(ctrl);
+	if ((__atomic_load_n(&bio->flags, __ATOMIC_ACQUIRE) &
+	    BIO_F_DONE) == 0) {
+		/*
+		 * The reset flushed queues before this bio was linked to a
+		 * tracker, or the tracker was already freed.  Complete it here
+		 * rather than leave bio_wait() spinning forever.
+		 */
+		bio_done(bio, BIO_STATUS_TIMEOUT, bio->nsectors);
+	}
+	return (0);
+}
