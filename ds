+	pmap->ref_count = 1;
+	pmap->is_kernel = 0;
+	memset(pmap->kernel_pml4, 0, sizeof(pmap->kernel_pml4));
+	if (parent != NULL) {
+		memcpy(pmap->kernel_pml4, parent->kernel_pml4,
+		    sizeof(pmap->kernel_pml4));
+	}
+	pmap->kernel_pml4[0] = 0;
+	pmap_sync_kernel(pmap);
+}
