+#include <kernel/drivers/disk/nvme/nvme.h>
+#include <kernel/mm/kmem.h>
+#include <kernel/smp/smp.h>
+#include <kernel/time.h>
+#include <mlibc/stdio.h>
+#include <mlibc/mlibc.h>
+
+#define	NVME_DONE_BATCH		32
+#define	NVME_ABORT_SETTLE_NS	1000000000ULL
+
+u64
+nvme_now_ns(void)
+{
+	struct timespec	ts;
+
+	/*
+	 * nanouptime() reads the timecounter directly rather than the tick
+	 * cached value, because a command deadline is measured in microseconds
+	 * and tick granularity would round it away.
+	 */
+	nanouptime(&ts);
+	return ((u64)ts.tv_sec * 1000000000ULL + (u64)ts.tv_nsec);
+}
+
+u64
+nvme_deadline_ns(u64 timeout_ns)
+{
+	return (nvme_now_ns() + timeout_ns);
+}
+
+/*
+ * True when the wait is over, by either clock.  The spin count exists because
+ * nvme_now_ns() returns a constant zero until the timecounter is wound, and a
+ * loop that trusted only the deadline would hang the boot on a controller
+ * that never answers.
+ */
+int
+nvme_wait_expired(u64 deadline_ns, u64 *spins)
+{
+	if (spins != NULL) {
+		(*spins)++;
+		if (*spins > NVME_SPIN_BUDGET) {
+			return (1);
+		}
+	}
+	return (nvme_now_ns() >= deadline_ns ? 1 : 0);
+}
+
+u32
+nvme_reg32(const nvme_ctrl_t *ctrl, u32 off)
+{
+	return (*(volatile u32 *)(ctrl->regs + off));
+}
+
+void
+nvme_reg32_set(nvme_ctrl_t *ctrl, u32 off, u32 value)
+{
+	*(volatile u32 *)(ctrl->regs + off) = value;
+}
+
+/*
+ * CAP, ASQ and ACQ are the only 64 bit registers this driver touches, and all
+ * three are naturally aligned inside the BAR, so a single 64 bit access is
+ * what the spec asks for.  Splitting ASQ into halves would leave the
+ * controller briefly reading a mixed address if it latched between writes.
+ */
+u64
+nvme_reg64(const nvme_ctrl_t *ctrl, u32 off)
+{
+	return (*(volatile u64 *)(ctrl->regs + off));
+}
+
+void
+nvme_reg64_set(nvme_ctrl_t *ctrl, u32 off, u64 value)
+{
+	*(volatile u64 *)(ctrl->regs + off) = value;
+}
