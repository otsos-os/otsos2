+/*
+ * CAP.TO bounds how long CSTS.RDY may lag CC.EN, in 500 ms units.  A
+ * controller reporting zero would give a zero budget, so the floor applies:
+ * the alternative is declaring a healthy controller dead on the first boot.
+ */
+static u64
+nvme_ready_timeout_ns(const nvme_ctrl_t *ctrl)
+{
+	u64	units, ns;
+
+	units = (ctrl->cap >> NVME_CAP_TO_SHIFT) & NVME_CAP_TO_MASK;
+	ns = units * NVME_CAP_TO_UNIT_NS;
+	if (ns < NVME_RESET_TIMEOUT_FLOOR_NS) {
+		ns = NVME_RESET_TIMEOUT_FLOOR_NS;
+	}
+	return (ns);
+}
+
+/*
+ * Wait for CSTS.RDY to reach `want`.  CFS is checked on every pass because a
+ * controller that has faulted will never move RDY again, and waiting out the
+ * full CAP.TO for it only delays the diagnosis.
+ */
+static int
+nvme_wait_ready(nvme_ctrl_t *ctrl, u32 want)
+{
+	u64	deadline, spins;
+	u32	csts;
+
+	deadline = nvme_deadline_ns(nvme_ready_timeout_ns(ctrl));
+	spins = 0;
+	for (;;) {
+		csts = nvme_reg32(ctrl, NVME_REG_CSTS);
+		if ((csts & NVME_CSTS_CFS) != 0) {
+			drivers_log("[NVME] controller fatal status while "
+			    "waiting for RDY=%u (csts=0x%x)\n", want, csts);
+			return (-1);
+		}
+		if (((csts & NVME_CSTS_RDY) != 0 ? 1U : 0U) == want) {
+			return (0);
+		}
+		if (nvme_wait_expired(deadline, &spins)) {
+			drivers_log("[NVME] timeout waiting for RDY=%u "
+			    "(csts=0x%x)\n", want, csts);
+			return (-1);
+		}
+		__asm__ volatile("pause");
+	}
+}
+
+int
+nvme_ctrl_disable(nvme_ctrl_t *ctrl)
+{
+	u32	cc;
+
+	cc = nvme_reg32(ctrl, NVME_REG_CC);
+	if ((cc & NVME_CC_EN) != 0) {
+		nvme_reg32_set(ctrl, NVME_REG_CC, cc & ~NVME_CC_EN);
+	}
+	return (nvme_wait_ready(ctrl, 0));
+}
+
+int
+nvme_ctrl_enable(nvme_ctrl_t *ctrl)
+{
+	u32	cc, aqa, mps_shift;
+
+	/*
+	 * AQA and the two admin base addresses may only be written while the
+	 * controller is disabled, so this runs after nvme_ctrl_disable().
+	 */
+	aqa = ((ctrl->admin_q.qdepth - 1) & NVME_AQA_QS_MASK) <<
+	    NVME_AQA_ASQS_SHIFT;
+	aqa |= ((ctrl->admin_q.qdepth - 1) & NVME_AQA_QS_MASK) <<
+	    NVME_AQA_ACQS_SHIFT;
+	nvme_reg32_set(ctrl, NVME_REG_AQA, aqa);
+	nvme_reg64_set(ctrl, NVME_REG_ASQ, ctrl->admin_q.sq_mem.phys);
+	nvme_reg64_set(ctrl, NVME_REG_ACQ, ctrl->admin_q.cq_mem.phys);
+
+	/*
+	 * CC.MPS must be the host page size.  The DMA tag that builds PRP lists
+	 * uses PAGE_SIZE as its boundary, so a controller page of any other
+	 * size would make the segment list and the PRP rules disagree -- and
+	 * that disagreement transfers wrong data under a success status rather
+	 * than failing, which is why it is set from PAGE_SIZE and never from
+	 * anything the controller suggests.
+	 */
+	mps_shift = 0;
+	while ((1U << (mps_shift + NVME_MPS_SHIFT_BIAS)) < PAGE_SIZE) {
+		mps_shift++;
+	}
+	cc = NVME_CC_EN;
+	cc |= (NVME_CC_CSS_NVM & NVME_CC_CSS_MASK) << NVME_CC_CSS_SHIFT;
+	cc |= (mps_shift & NVME_CC_MPS_MASK) << NVME_CC_MPS_SHIFT;
+	cc |= (NVME_CC_AMS_RR & NVME_CC_AMS_MASK) << NVME_CC_AMS_SHIFT;
+	cc |= (u32)NVME_SQES_SHIFT << NVME_CC_IOSQES_SHIFT;
+	cc |= (u32)NVME_CQES_SHIFT << NVME_CC_IOCQES_SHIFT;
+	nvme_reg32_set(ctrl, NVME_REG_CC, cc);
+
+	if (nvme_wait_ready(ctrl, 1) != 0) {
+		return (-1);
+	}
+	ctrl->admin_q.created = 1;
+	return (0);
+}
+
+/*
+ * Stop the controller, complete everything that was in flight, and bring it
+ * back up.  The CSTS.RDY waits inside run for milliseconds, so no queue lock
+ * is held across them -- a spinlock holder has interrupts off and cannot
+ * afford that.  Never call this from the interrupt handler.
+ */
+int
+nvme_ctrl_reset(nvme_ctrl_t *ctrl)
+{
+	u32	i;
+	int	error;
+
+	if (ctrl == NULL) {
+		return (-1);
+	}
+	if (__atomic_exchange_n(&ctrl->resetting, 1, __ATOMIC_ACQ_REL) != 0) {
+		/* Another CPU owns the reset; it will complete our requests. */
+		return (0);
+	}
+	ctrl->nreset++;
+
+	/*
+	 * Mask every vector first.  Between the disable below and the queues
+	 * being rebuilt the CQ memory is being rewritten, and a handler running
+	 * over it would read stale phase bits and complete trackers twice.
+	 * Masking only some would leave exactly that window open on the rest.
+	 */
+	if (ctrl->irq_msi != 0) {
+		for (i = 0; i < ctrl->nirq; i++) {
+			(void)pci_msix_mask(ctrl->pci, (u16)ctrl->irq[i].entry,
+			    1);
+		}
+	} else {
+		nvme_reg32_set(ctrl, NVME_REG_INTMS, 0xFFFFFFFFU);
+	}
+
+	error = nvme_ctrl_disable(ctrl);
+	/*
+	 * The controller forgot every I/O queue when CC.EN dropped, so the whole
+	 * set is torn down and recreated.
+	 */
+	for (i = 0; i < NVME_MAX_IO_QUEUES; i++) {
+		ctrl->io_q[i].created = 0;
+	}
+	ctrl->admin_q.created = 0;
+
+	for (i = 0; i < NVME_MAX_IO_QUEUES; i++) {
+		nvme_queue_flush_inflight(&ctrl->io_q[i], BIO_STATUS_TIMEOUT);
+	}
+	nvme_queue_flush_inflight(&ctrl->admin_q, BIO_STATUS_TIMEOUT);
+	for (i = 0; i < NVME_MAX_IO_QUEUES; i++) {
+		nvme_queue_reset(&ctrl->io_q[i]);
+	}
+	nvme_queue_reset(&ctrl->admin_q);
+
+	if (error == 0) {
+		error = nvme_ctrl_enable(ctrl);
+	}
+	if (error == 0) {
+		/*
+		 * Ask for the full set again, not the count we happened to be
+		 * running: the previous count may itself have been the result of
+		 * a transient short grant, and starting from it would make that
+		 * shortfall permanent.
+		 */
+		ctrl->nioq = ctrl->nioq_max;
+		error = nvme_ioq_create(ctrl);
+	}
+
+	if (ctrl->irq_msi != 0) {
+		for (i = 0; i < ctrl->nirq; i++) {
+			(void)pci_msix_mask(ctrl->pci, (u16)ctrl->irq[i].entry,
+			    0);
+		}
+	} else {
+		nvme_reg32_set(ctrl, NVME_REG_INTMC, 0xFFFFFFFFU);
+	}
+
+	if (error != 0) {
+		/*
+		 * Dead for good.  Leaving failed set keeps submit from handing
+		 * more requests to a controller that cannot take them, which
+		 * would otherwise surface as a stream of timeouts instead of one
+		 * clear failure.
+		 */
+		ctrl->failed = 1;
+		drivers_log("[NVME] controller %u reset failed, disk offline\n",
+		    ctrl->unit);
+	} else {
+		drivers_log("[NVME] controller %u reset complete\n",
+		    ctrl->unit);
+	}
+	__atomic_store_n(&ctrl->resetting, 0, __ATOMIC_RELEASE);
+	return (error);
+}
+
+/*
+ * Identify strings are space padded and not terminated.  Trailing spaces are
+ * trimmed so a log line does not carry 30 blanks.
+ */
+static void
+nvme_id_string(char *out, const char *in, u32 len)
+{
+	u32	i, end;
+
+	end = 0;
+	for (i = 0; i < len; i++) {
+		out[i] = in[i];
+		if (in[i] != ' ' && in[i] != '\0') {
+			end = i + 1;
+		}
+	}
+	out[end] = '\0';
+}
+
+/*
+ * Four tags, because four different constraints apply.  Splitting them is not
+ * cosmetic: dma_mem_alloc() refuses a request larger than the tag's boundary,
+ * so the PAGE_SIZE boundary that makes data segments obey the PRP rules would
+ * make it impossible to allocate a queue or a run of PRP pages.
+ */
+static int
+nvme_tags_create(nvme_ctrl_t *ctrl)
+{
+	u64	q_bytes, prp_bytes;
+
+	/*
+	 * Top tag holds no opinion of its own -- the addressing window comes
+	 * from the bus above, and NVMe controllers are 64 bit addressing by
+	 * definition, so there is nothing here to tighten.
+	 */
+	if (dma_tag_create(bus_get_dma_tag(ctrl->nb_dev), 1, DMA_BOUNDARY_NONE,
+	    0, DMA_HIGHADDR_ANY, 0, 0, DMA_SEGSZ_MAX, 0, "nvme",
+	    &ctrl->tag) != 0) {
+		return (-1);
+	}
+	/*
+	 * Queues are physically contiguous and page aligned, in one segment.
+	 * maxsize is the largest queue this driver will ask for, so a coding
+	 * error that asks for more is rejected here rather than handed to the
+	 * controller.
+	 */
+	q_bytes = (u64)NVME_IO_QDEPTH_MAX * NVME_SQE_SIZE;
+	if (dma_tag_create(ctrl->tag, PAGE_SIZE, DMA_BOUNDARY_NONE, 0,
+	    DMA_HIGHADDR_ANY, q_bytes, 1, DMA_SEGSZ_MAX, 0, "nvme-queue",
+	    &ctrl->q_tag) != 0) {
+		goto fail;
+	}
+	/* One PRP list page per command slot, allocated as one run. */
+	prp_bytes = (u64)NVME_IO_QDEPTH_MAX * PAGE_SIZE;
+	if (dma_tag_create(ctrl->tag, PAGE_SIZE, DMA_BOUNDARY_NONE, 0,
+	    DMA_HIGHADDR_ANY, prp_bytes, 1, DMA_SEGSZ_MAX, 0, "nvme-prp",
+	    &ctrl->prp_tag) != 0) {
+		goto fail;
+	}
+	/*
+	 * Data buffers.  boundary = PAGE_SIZE is the whole trick: it stops
+	 * dma_seg_append() from merging two physically adjacent pages, so the
+	 * segment list comes out with a possibly offset first entry and page
+	 * aligned entries after it -- the PRP rules exactly.  nsegments is one
+	 * more than the transfer's page count because a buffer starting mid
+	 * page spans one extra page.
+	 */
+	if (dma_tag_create(ctrl->tag, 1, PAGE_SIZE, 0, DMA_HIGHADDR_ANY,
+	    (u64)NVME_MAX_XFER_PAGES * PAGE_SIZE, NVME_MAX_XFER_PAGES + 1,
+	    PAGE_SIZE, 0, "nvme-xfer", &ctrl->xfer_tag) != 0) {
+		goto fail;
+	}
+	return (0);
+fail:
+	nvme_tags_destroy(ctrl);
+	return (-1);
+}
+
+static void
+nvme_tags_destroy(nvme_ctrl_t *ctrl)
+{
+	if (ctrl->xfer_tag != NULL) {
+		dma_tag_destroy(ctrl->xfer_tag);
+		ctrl->xfer_tag = NULL;
+	}
+	if (ctrl->prp_tag != NULL) {
+		dma_tag_destroy(ctrl->prp_tag);
+		ctrl->prp_tag = NULL;
+	}
+	if (ctrl->q_tag != NULL) {
+		dma_tag_destroy(ctrl->q_tag);
+		ctrl->q_tag = NULL;
+	}
+	if (ctrl->tag != NULL) {
+		dma_tag_destroy(ctrl->tag);
+		ctrl->tag = NULL;
+	}
+}
+
+/*
+ * Read CAP and decide the things that cannot change afterwards: doorbell
+ * stride, host page size agreement, and queue depth.  Refusing here is
+ * deliberate -- every one of these mismatches would otherwise show up as
+ * silent data corruption rather than a failed attach.
+ */
+static int
+nvme_probe_geometry(nvme_ctrl_t *ctrl)
+{
+	u64	mpsmin, mpsmax, css;
+	u32	mqes;
+
+	ctrl->cap = nvme_reg64(ctrl, NVME_REG_CAP);
+	ctrl->dstrd = (u32)((ctrl->cap >> NVME_CAP_DSTRD_SHIFT) &
+	    NVME_CAP_DSTRD_MASK);
+	ctrl->mps = PAGE_SIZE;
+
+	css = (ctrl->cap >> NVME_CAP_CSS_SHIFT) & NVME_CAP_CSS_MASK;
+	if ((css & NVME_CAP_CSS_NVM) == 0) {
+		drivers_log("[NVME] controller does not support the NVM "
+		    "command set (css=0x%llx)\n", (unsigned long long)css);
+		return (-1);
+	}
+
+	mpsmin = (ctrl->cap >> NVME_CAP_MPSMIN_SHIFT) & NVME_CAP_MPS_MASK;
+	mpsmax = (ctrl->cap >> NVME_CAP_MPSMAX_SHIFT) & NVME_CAP_MPS_MASK;
+	if (PAGE_SIZE < (1ULL << (mpsmin + NVME_MPS_SHIFT_BIAS)) ||
+	    PAGE_SIZE > (1ULL << (mpsmax + NVME_MPS_SHIFT_BIAS))) {
+		drivers_log("[NVME] host page %u outside controller range "
+		    "[%llu,%llu]\n", (u32)PAGE_SIZE,
+		    (unsigned long long)(1ULL << (mpsmin +
+		    NVME_MPS_SHIFT_BIAS)),
+		    (unsigned long long)(1ULL << (mpsmax +
+		    NVME_MPS_SHIFT_BIAS)));
+		return (-1);
+	}
+
+	mqes = (u32)(ctrl->cap & NVME_CAP_MQES_MASK) + 1;
+	ctrl->qdepth = newbus_config_driver_get_u32(NVME_DRIVER_NAME,
+	    "IoQueueDepth", NVME_IO_QDEPTH_DEFAULT);
+	if (ctrl->qdepth > mqes) {
+		ctrl->qdepth = mqes;
+	}
+	if (ctrl->qdepth > NVME_IO_QDEPTH_MAX) {
+		ctrl->qdepth = NVME_IO_QDEPTH_MAX;
+	}
+	if (ctrl->qdepth < NVME_IO_QDEPTH_MIN) {
+		ctrl->qdepth = NVME_IO_QDEPTH_MIN;
+	}
+	return (0);
+}
+
+int
+nvme_identify(nvme_ctrl_t *ctrl)
+{
+	const nvme_id_ctrl_t	*id;
+	nvme_sqe_t		sqe;
+	u64			max_xfer;
+
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_IDENTIFY;
+	sqe.prp1 = ctrl->id_mem.phys;
+	sqe.cdw10 = NVME_CNS_CONTROLLER;
+	memset(ctrl->id_mem.virt, 0, NVME_ID_DATA_SIZE);
+	if (nvme_admin_cmd(ctrl, &sqe, NULL, NULL) != 0) {
+		return (-1);
+	}
+
+	id = ctrl->id_mem.virt;
+	nvme_id_string(ctrl->serial, id->sn, NVME_SERIAL_LEN);
+	nvme_id_string(ctrl->model, id->mn, NVME_MODEL_LEN);
+	ctrl->cntlid = id->cntlid;
+	ctrl->vwc = (u8)(id->vwc & NVME_ID_CTRL_VWC_PRESENT);
+	ctrl->ns_count = id->nn;
+
+	/*
+	 * MDTS is log2 of the maximum transfer in controller pages; zero means
+	 * the controller states no limit, which is not the same as no limit
+	 * existing.  The driver's own ceiling is what one PRP list page can
+	 * name, so the smaller of the two wins -- and the driver's own is the
+	 * one that must be enforced, since exceeding it builds a truncated PRP
+	 * list rather than returning an error.
+	 */
+	max_xfer = (u64)NVME_MAX_XFER_PAGES * PAGE_SIZE;
+	if (id->mdts != NVME_MDTS_UNLIMITED) {
+		if (id->mdts >= 32) {
+			/* Absurd shift: treat as unlimited rather than
+			 * overflow the shift. */
+			drivers_log("[NVME] ignoring implausible MDTS %u\n",
+			    id->mdts);
+		} else if (((u64)ctrl->mps << id->mdts) < max_xfer) {
+			max_xfer = (u64)ctrl->mps << id->mdts;
+		}
+	}
+	ctrl->max_xfer = (u32)max_xfer;
+
+	drivers_log("[NVME] nvme%u: %s sn=%s cntlid=%u ns=%u mdts=%u "
+	    "maxio=%uKiB vwc=%u qdepth=%u\n", ctrl->unit, ctrl->model,
+	    ctrl->serial, ctrl->cntlid, ctrl->ns_count, id->mdts,
+	    ctrl->max_xfer / 1024U, ctrl->vwc, ctrl->qdepth);
+	return (0);
+}
+
+/*
+ * Negotiate the I/O queue count.  The controller answers with what it granted,
+ * which may be fewer than asked and is never assumed: ctrl->nioq is lowered to
+ * the grant so no queue is created that the controller does not know about.
+ * A controller granting zero cannot serve I/O at all.
+ */
+static int
+nvme_set_num_queues(nvme_ctrl_t *ctrl)
+{
+	nvme_sqe_t	sqe;
+	u32		cdw0, nsqa, ncqa, granted;
+
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_SET_FEATURES;
+	sqe.cdw10 = NVME_FEAT_NUM_QUEUES;
+	/* Both fields are zero based: N-1 requests N queues. */
+	sqe.cdw11 = ((ctrl->nioq - 1U) << 16) | (ctrl->nioq - 1U);
+	cdw0 = 0;
+	if (nvme_admin_cmd(ctrl, &sqe, &cdw0, NULL) != 0) {
+		return (-1);
+	}
+	nsqa = (cdw0 & 0xFFFFU) + 1U;
+	ncqa = ((cdw0 >> 16) & 0xFFFFU) + 1U;
+	if (nsqa < 1 || ncqa < 1) {
+		drivers_log("[NVME] controller granted no I/O queues "
+		    "(cdw0=0x%x)\n", cdw0);
+		return (-1);
+	}
+	/*
+	 * The grant is a pair count: an SQ without its CQ is useless, so the
+	 * smaller of the two is what can actually be run.
+	 */
+	granted = nsqa < ncqa ? nsqa : ncqa;
+	if (granted < ctrl->nioq) {
+		drivers_log("[NVME] nvme%u: asked %u I/O queues, granted %u\n",
+		    ctrl->unit, ctrl->nioq, granted);
+		ctrl->nioq = granted;
+	}
+	return (0);
+}
+
+/*
+ * Create one I/O queue pair.  CQ before SQ: Create I/O Submission Queue names
+ * its completion queue, and a controller asked to bind to a CQ that does not
+ * exist yet fails the command.
+ */
+static int
+nvme_ioq_create_one(nvme_ctrl_t *ctrl, nvme_queue_t *q)
+{
+	nvme_sqe_t	sqe;
+
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_CREATE_IO_CQ;
+	sqe.prp1 = q->cq_mem.phys;
+	sqe.cdw10 = ((q->qdepth - 1) << 16) | q->qid;
+	sqe.cdw11 = ((u32)q->cq_vector << 16) | NVME_CQ_IEN | NVME_CQ_PC;
+	if (nvme_admin_cmd(ctrl, &sqe, NULL, NULL) != 0) {
+		return (-1);
+	}
+
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_CREATE_IO_SQ;
+	sqe.prp1 = q->sq_mem.phys;
+	sqe.cdw10 = ((q->qdepth - 1) << 16) | q->qid;
+	sqe.cdw11 = ((u32)q->qid << 16) | NVME_SQ_PC;
+	if (nvme_admin_cmd(ctrl, &sqe, NULL, NULL) != 0) {
+		/*
+		 * Take the CQ back down.  Leaving it behind would make the next
+		 * Create I/O Completion Queue fail with an already-in-use
+		 * status, and the reset path would then never recover.
+		 */
+		memset(&sqe, 0, sizeof(sqe));
+		sqe.opc = NVME_ADMIN_DELETE_IO_CQ;
+		sqe.cdw10 = q->qid;
+		(void)nvme_admin_cmd(ctrl, &sqe, NULL, NULL);
+		return (-1);
+	}
+	q->created = 1;
+	return (0);
+}
+
+static int
+nvme_ioq_delete_one(nvme_ctrl_t *ctrl, nvme_queue_t *q)
+{
+	nvme_sqe_t	sqe;
+	int		error;
+
+	if (q->created == 0) {
+		return (0);
+	}
+	/*
+	 * SQ before CQ, the reverse of creation: deleting a CQ that still has a
+	 * submission queue bound to it is invalid, and the controller may
+	 * discard the request rather than the queue.
+	 */
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_DELETE_IO_SQ;
+	sqe.cdw10 = q->qid;
+	error = nvme_admin_cmd(ctrl, &sqe, NULL, NULL);
+
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_DELETE_IO_CQ;
+	sqe.cdw10 = q->qid;
+	if (nvme_admin_cmd(ctrl, &sqe, NULL, NULL) != 0) {
+		error = -1;
+	}
+	q->created = 0;
+	return (error);
+}
+
+int
+nvme_ioq_create(nvme_ctrl_t *ctrl)
+{
+	u32	i;
+
+	if (nvme_set_num_queues(ctrl) != 0) {
+		return (-1);
+	}
+	for (i = 0; i < ctrl->nioq; i++) {
+		if (nvme_ioq_create_one(ctrl, &ctrl->io_q[i]) == 0) {
+			continue;
+		}
+		/*
+		 * A failure partway leaves the earlier queues live and usable.
+		 * Shrinking to what was created beats failing attach outright --
+		 * but queue 0 failing means no I/O path at all.
+		 */
+		if (i == 0) {
+			return (-1);
+		}
+		drivers_log("[NVME] nvme%u: queue %u creation failed, "
+		    "running with %u\n", ctrl->unit, i, i);
+		ctrl->nioq = i;
+		break;
+	}
+	return (0);
+}
+
+int
+nvme_ioq_delete(nvme_ctrl_t *ctrl)
+{
+	u32	i;
+	int	error;
+
+	error = 0;
+	/*
+	 * Highest queue first.  Not required by the spec, but it keeps the live
+	 * set a prefix of the array at every point, which is the invariant the
+	 * submit path's modulo depends on.
+	 */
+	for (i = ctrl->nioq; i > 0; i--) {
+		if (nvme_ioq_delete_one(ctrl, &ctrl->io_q[i - 1]) != 0) {
+			error = -1;
+		}
+	}
+	return (error);
+}
+
+/*
+ * Fill in one namespace from its Identify data.  Returns negative when the
+ * namespace cannot be used, which is not an attach failure: an unusable
+ * namespace among several is skipped, not fatal.
+ */
+static int
+nvme_ns_setup(nvme_ctrl_t *ctrl, nvme_ns_t *ns, u32 nsid)
+{
+	const nvme_id_ns_t	*id;
+	nvme_sqe_t		sqe;
+	u32			lbaf, lbads, ms, index;
+
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_IDENTIFY;
+	sqe.nsid = nsid;
+	sqe.prp1 = ctrl->id_mem.phys;
+	sqe.cdw10 = NVME_CNS_NAMESPACE;
+	memset(ctrl->id_mem.virt, 0, NVME_ID_DATA_SIZE);
+	if (nvme_admin_cmd(ctrl, &sqe, NULL, NULL) != 0) {
+		return (-1);
+	}
+
+	id = ctrl->id_mem.virt;
+	if (id->nsze == 0) {
+		return (-1);
+	}
+	index = id->flbas & NVME_NS_FLBAS_INDEX_MASK;
+	if (index >= NVME_NS_LBAF_COUNT || index > id->nlbaf) {
+		drivers_log("[NVME] nsid %u: FLBAS index %u out of range\n",
+		    nsid, index);
+		return (-1);
+	}
+	lbaf = id->lbaf[index];
+	ms = lbaf & NVME_NS_LBAF_MS_MASK;
+	lbads = (lbaf >> NVME_NS_LBAF_LBADS_SHIFT) & NVME_NS_LBAF_LBADS_MASK;
+	/*
+	 * Metadata per block would need either a separate metadata buffer or
+	 * interleaved metadata in the data stream, and this driver builds
+	 * neither.  Skipping the namespace is the only honest option: issuing
+	 * plain reads against it would return short data as if it were whole.
+	 */
+	if (ms != 0) {
+		drivers_log("[NVME] nsid %u: %u byte metadata per block is "
+		    "unsupported, skipping\n", nsid, ms);
+		return (-1);
+	}
+	if (lbads < 9 || lbads > 20) {
+		drivers_log("[NVME] nsid %u: implausible LBA size 2^%u\n",
+		    nsid, lbads);
+		return (-1);
+	}
+
+	memset(ns, 0, sizeof(*ns));
+	ns->ctrl = ctrl;
+	ns->nsid = nsid;
+	ns->nsze = id->nsze;
+	ns->lba_size = 1U << lbads;
+
+	snprintf(ns->disk.name, sizeof(ns->disk.name), "nvme%un%u",
+	    ctrl->unit, nsid);
+	ns->disk.ops = &nvme_disk_ops;
+	ns->disk.private_data = ns;
+	ns->disk.total_sectors = ns->nsze;
+	ns->disk.sector_size = ns->lba_size;
+	ns->disk.type = DISK_TYPE_NVME;
+	ns->disk.flags = ctrl->vwc != 0 ? 0 : DISK_F_NO_FLUSH;
+	/*
+	 * NLB is a 16 bit zero based field, so one command can never carry more
+	 * than 65536 blocks whatever MDTS says.  Clamping here rather than in
+	 * the submit path keeps the ceiling visible to the block layer, which
+	 * chunks large requests against it.
+	 */
+	ns->disk.max_io_sectors = ctrl->max_xfer / ns->lba_size;
+	if (ns->disk.max_io_sectors > 0x10000U) {
+		ns->disk.max_io_sectors = 0x10000U;
+	}
+	if (ns->disk.max_io_sectors == 0) {
+		drivers_log("[NVME] nsid %u: %u byte blocks exceed the %u byte "
+		    "transfer ceiling\n", nsid, ns->lba_size, ctrl->max_xfer);
+		return (-1);
+	}
+	return (0);
+}
+
+int
+nvme_ns_attach(nvme_ctrl_t *ctrl)
+{
+	const u32	*list;
+	nvme_sqe_t	sqe;
+	u32		i, nsid, attached;
+
+	memset(&sqe, 0, sizeof(sqe));
+	sqe.opc = NVME_ADMIN_IDENTIFY;
+	sqe.nsid = 0;
+	sqe.prp1 = ctrl->id_mem.phys;
+	sqe.cdw10 = NVME_CNS_ACTIVE_NSLIST;
+	memset(ctrl->id_mem.virt, 0, NVME_ID_DATA_SIZE);
+	if (nvme_admin_cmd(ctrl, &sqe, NULL, NULL) != 0) {
+		return (-1);
+	}
+
+	list = ctrl->id_mem.virt;
+	attached = 0;
+	/*
+	 * The list is zero terminated and holds at most NVME_NSLIST_MAX
+	 * entries; both bounds are checked because a controller that fails to
+	 * terminate it would otherwise walk off the page.
+	 */
+	for (i = 0; i < NVME_NSLIST_MAX && attached < NVME_MAX_NAMESPACES;
+	    i++) {
+		nsid = list[i];
+		if (nsid == 0) {
+			break;
+		}
+		if (nvme_ns_setup(ctrl, &ctrl->ns[attached], nsid) != 0) {
+			continue;
+		}
+		if (disk_register(&ctrl->ns[attached].disk) != 0) {
+			drivers_log("[NVME] nsid %u: disk_register failed\n",
+			    nsid);
+			continue;
+		}
+		ctrl->ns[attached].registered = 1;
+		drivers_log("[NVME] %s: %llu blocks of %u bytes (%llu MiB), "
+		    "maxio=%u blocks\n", ctrl->ns[attached].disk.name,
+		    (unsigned long long)ctrl->ns[attached].nsze,
+		    ctrl->ns[attached].lba_size,
+		    (unsigned long long)(disk_capacity_bytes(
+		    &ctrl->ns[attached].disk) >> 20),
+		    ctrl->ns[attached].disk.max_io_sectors);
+		attached++;
+	}
+	if (attached == 0) {
+		drivers_log("[NVME] nvme%u: no usable namespace\n", ctrl->unit);
+		return (-1);
+	}
+	return (0);
+}
+
+void
+nvme_ns_detach(nvme_ctrl_t *ctrl)
+{
+	u32	i;
+
+	for (i = 0; i < NVME_MAX_NAMESPACES; i++) {
+		if (ctrl->ns[i].registered == 0) {
+			continue;
+		}
+		(void)disk_unregister(&ctrl->ns[i].disk);
+		ctrl->ns[i].registered = 0;
+	}
+}
+
+static void
+nvme_ctrl_free(nvme_ctrl_t *ctrl)
+{
+	u32	i;
+
+	if (ctrl == NULL) {
+		return;
+	}
+	for (i = 0; i < NVME_MAX_IO_QUEUES; i++) {
+		nvme_queue_fini(&ctrl->io_q[i]);
+	}
+	nvme_queue_fini(&ctrl->admin_q);
+	dma_mem_free(&ctrl->id_mem);
+	nvme_tags_destroy(ctrl);
+	kmem_free(ctrl);
+}
+
+/*
+ * How many I/O queues to ask for, before the controller has had its say.  One
+ * per CPU is the point of the exercise -- a queue is only useful if a CPU can
+ * own it -- bounded by the array and by an explicit registry override for a
+ * host that wants fewer.
+ *
+ * smp_cpu_count() can report 0 or 1 this early depending on how far SMP got;
+ * either way the floor of one queue keeps the I/O path alive.
+ */
+static u32
+nvme_ioq_count_pick(nvme_ctrl_t *ctrl)
+{
+	u32	want;
+	int	cpus;
+
+	(void)ctrl;
+	cpus = smp_cpu_count();
+	want = cpus > 0 ? (u32)cpus : 1U;
+	want = newbus_config_driver_get_u32(NVME_DRIVER_NAME, "IoQueues", want);
+	if (want < 1) {
+		want = 1;
+	}
+	if (want > NVME_MAX_IO_QUEUES) {
+		want = NVME_MAX_IO_QUEUES;
+	}
+	return (want);
+}
+
+/*
+ * Claim one vector per queue: entry 0 for admin, one per I/O queue after it.
+ * The bus registered one IRQ resource per MSI-X entry, so each allocation with
+ * rid 0 takes the next free one -- the walk is in the allocator, not here.
+ *
+ * A device that only has single-message MSI, or a legacy line, yields exactly
+ * one resource.  That is not a failure: nirq drops to 1, irq_shared is set, and
+ * every queue binds its CQ to entry 0 with one handler sweeping all of them.
+ */
+static int
+nvme_irq_alloc(nvme_ctrl_t *ctrl)
+{
+	nvme_irq_t	*irq;
+	u32		want, i;
+	int		rid;
+
+	want = ctrl->nioq + 1U;
+	if (want > NVME_MAX_VECTORS) {
+		want = NVME_MAX_VECTORS;
+	}
+	for (i = 0; i < want; i++) {
+		irq = &ctrl->irq[i];
+		irq->ctrl = ctrl;
+		rid = 0;
+		irq->res = bus_alloc_resource_any(ctrl->nb_dev, SYS_RES_IRQ,
+		    &rid, RF_ACTIVE);
+		if (irq->res == NULL) {
+			break;
+		}
+		/*
+		 * `start` is the MSI-X entry index for an MSI resource and the
+		 * GSI for a legacy one.  Only the MSI case is ever fed back to
+		 * the bus, so recording it unconditionally is harmless.
+		 */
+		irq->entry = (u32)irq->res->start;
+		/*
+		 * Queue binding is deferred: which queue this vector drains is
+		 * only known once the total is final, because a short allocation
+		 * turns the whole set into a shared one.
+		 */
+		irq->queue = NULL;
+		if (bus_setup_intr(ctrl->nb_dev, irq->res, nvme_intr, irq,
+		    &irq->cookie) != 0) {
+			bus_release_resource(ctrl->nb_dev, SYS_RES_IRQ,
+			    irq->res->rid, irq->res);
+			irq->res = NULL;
+			break;
+		}
+		irq->intr_res = bus_intr_resource(irq->cookie);
+		if (irq->intr_res == NULL) {
+			irq->intr_res = irq->res;
+		}
+		irq->is_msi = (u8)(bus_intr_is_msi(irq->cookie) != 0);
+		ctrl->nirq = i + 1U;
+		/*
+		 * A non-MSI resource is a shared legacy line; there is only one
+		 * and asking for more would hand back the same line again.
+		 */
+		if (irq->is_msi == 0) {
+			break;
+		}
+	}
+	if (ctrl->nirq == 0) {
+		return (-1);
+	}
+	ctrl->irq_msi = ctrl->irq[0].is_msi;
+	/*
+	 * One vector for everything: the only case that genuinely has to share.
+	 * The handler sweeps all queues, so the queues stay -- a shared vector
+	 * costs a sweep per interrupt, not a queue.
+	 */
+	if (ctrl->nirq == 1) {
+		ctrl->irq_shared = 1;
+		for (i = 0; i < NVME_MAX_IO_QUEUES; i++) {
+			ctrl->io_q[i].cq_vector = NVME_ADMIN_VECTOR;
+		}
+		ctrl->nioq_max = ctrl->nioq;
+		return (0);
+	}
+	/*
+	 * Short of what was asked but more than one: run fewer queues rather
+	 * than pile several onto one vector.  A queue whose CQ shares a vector
+	 * with another gains nothing over not existing -- both completions come
+	 * through the same handler either way -- while an unshared vector per
+	 * queue is the whole reason for having more than one.
+	 *
+	 * The queues above the new count keep their DMA memory until detach.
+	 * Freeing them here would mean tearing down queues that a later reset
+	 * could have used, to reclaim memory the controller already committed.
+	 */
+	if (ctrl->nirq < ctrl->nioq + 1U) {
+		drivers_log("[NVME] nvme%u: %u vectors for %u queues, "
+		    "running %u\n", ctrl->unit, ctrl->nirq, ctrl->nioq,
+		    ctrl->nirq - 1U);
+		ctrl->nioq = ctrl->nirq - 1U;
+	}
+	ctrl->irq_shared = 0;
+	ctrl->irq[0].queue = &ctrl->admin_q;
+	for (i = 0; i < ctrl->nioq; i++) {
+		ctrl->irq[i + 1U].queue = &ctrl->io_q[i];
+		ctrl->io_q[i].cq_vector = (u16)ctrl->irq[i + 1U].entry;
+	}
+	ctrl->nioq_max = ctrl->nioq;
+	return (0);
+}
+
+static void
+nvme_irq_free(nvme_ctrl_t *ctrl)
+{
+	u32	i;
+
+	for (i = 0; i < ctrl->nirq; i++) {
+		if (ctrl->irq[i].cookie != NULL) {
+			bus_teardown_intr(ctrl->nb_dev,
+			    ctrl->irq[i].intr_res, ctrl->irq[i].cookie);
+			ctrl->irq[i].cookie = NULL;
+			ctrl->irq[i].intr_res = NULL;
+		}
+		if (ctrl->irq[i].res != NULL) {
+			bus_release_resource(ctrl->nb_dev, SYS_RES_IRQ,
+			    ctrl->irq[i].res->rid, ctrl->irq[i].res);
+			ctrl->irq[i].res = NULL;
+		}
+	}
+	ctrl->nirq = 0;
+}
+
+static int
+nvme_pci_probe(pci_device_t *pdev, const pci_match_t *match)
+{
+	nvme_ctrl_t	*ctrl;
+	pci_bar_t	bar;
+	u64		dbl_span;
+	u32		qi;
+	int		index;
+
+	(void)match;
+
+	if (pci_read_bar(pdev, 0, &bar) != 0 || bar.is_io || bar.base == 0 ||
+	    bar.size < NVME_BAR_MIN) {
+		return (-1);
+	}
+	for (index = 0; index < NVME_MAX_CONTROLLERS; index++) {
+		if (nvme_ctrls[index] == NULL) {
+			break;
+		}
+	}
+	if (index == NVME_MAX_CONTROLLERS) {
+		return (-1);
+	}
+	ctrl = kmem_calloc(1, sizeof(*ctrl));
+	if (ctrl == NULL) {
+		return (-1);
+	}
+	ctrl->pci = pdev;
+	ctrl->nb_dev = pdev->nb_device;
+	ctrl->unit = (u8)index;
+	pci_enable_memory_space(pdev);
+	pci_enable_bus_mastering(pdev);
+	ctrl->regs = pmap_map_mmio(bar.base, bar.size);
+	if (ctrl->regs == NULL) {
+		kmem_free(ctrl);
+		return (-1);
+	}
+	if (nvme_probe_geometry(ctrl) != 0) {
+		kmem_free(ctrl);
+		return (-1);
+	}
+	ctrl->nioq = nvme_ioq_count_pick(ctrl);
+
+	for (;;) {
+		dbl_span = NVME_DBL_BASE +
+		    ((((u64)NVME_IOQ_ID_BASE + ctrl->nioq - 1ULL) * 2ULL) +
+		    2ULL) * (4ULL << ctrl->dstrd);
+		if (dbl_span <= bar.size) {
+			break;
+		}
+		if (ctrl->nioq <= 1) {
+			drivers_log("[NVME] BAR0 of %llu bytes cannot hold "
+			    "doorbells up to %llu (dstrd=%u)\n",
+			    (unsigned long long)bar.size,
+			    (unsigned long long)dbl_span, ctrl->dstrd);
+			kmem_free(ctrl);
+			return (-1);
+		}
+		ctrl->nioq--;
+	}
+	if (nvme_tags_create(ctrl) != 0) {
+		kmem_free(ctrl);
+		return (-1);
+	}
+	if (dma_mem_alloc(ctrl->prp_tag, NVME_ID_DATA_SIZE, DMA_F_NOWAIT,
+	    &ctrl->id_mem) != 0) {
+		nvme_ctrl_free(ctrl);
+		return (-1);
+	}
+	if (nvme_queue_init(ctrl, &ctrl->admin_q, 0, NVME_ADMIN_QDEPTH) != 0) {
+		nvme_ctrl_free(ctrl);
+		return (-1);
+	}
+	for (qi = 0; qi < ctrl->nioq; qi++) {
+		if (nvme_queue_init(ctrl, &ctrl->io_q[qi],
+		    (u16)(NVME_IOQ_ID_BASE + qi), ctrl->qdepth) == 0) {
+			continue;
+		}
+
+		if (qi == 0) {
+			nvme_ctrl_free(ctrl);
+			return (-1);
+		}
+		drivers_log("[NVME] nvme%u: queue %u alloc failed, "
+		    "running with %u\n", ctrl->unit, qi, qi);
+		ctrl->nioq = qi;
+		break;
+	}
+
+	if (nvme_irq_alloc(ctrl) != 0) {
+		nvme_irq_free(ctrl);
+		nvme_ctrl_free(ctrl);
+		return (-1);
+	}
+
+	if (nvme_ctrl_disable(ctrl) != 0 || nvme_ctrl_enable(ctrl) != 0 ||
+	    nvme_identify(ctrl) != 0 || nvme_ioq_create(ctrl) != 0 ||
+	    nvme_ns_attach(ctrl) != 0) {
+		nvme_ns_detach(ctrl);
+		(void)nvme_ioq_delete(ctrl);
+		(void)nvme_ctrl_disable(ctrl);
+		nvme_irq_free(ctrl);
+		nvme_ctrl_free(ctrl);
+		return (-1);
+	}
+
+	pdev->driver_data = ctrl;
+	nvme_ctrls[index] = ctrl;
+	drivers_log("[NVME] nvme%u attached: irq=%s vectors=%u ioq=%u "
+	    "dstrd=%u\n", ctrl->unit,
+	    ctrl->irq_msi != 0 ? (ctrl->irq_shared != 0 ? "msi-shared" : "msi") :
+	    "legacy", ctrl->nirq, ctrl->nioq, ctrl->dstrd);
+	return (0);
+}
+
+static void
+nvme_pci_remove(pci_device_t *pdev)
+{
+	nvme_ctrl_t	*ctrl;
+	u32		qi;
+	int		index;
+
+	ctrl = pdev->driver_data;
+	if (ctrl == NULL) {
+		return;
+	}
+	/*
+	 * Teardown order: stop new work, stop the device answering, then
+	 * release what the answers would have landed in.  Freeing the queues
+	 * while the controller can still post a CQE into them is the one
+	 * ordering mistake here that corrupts memory rather than leaking it.
+	 */
+	nvme_ns_detach(ctrl);
+	(void)nvme_ioq_delete(ctrl);
+	(void)nvme_ctrl_disable(ctrl);
+	nvme_irq_free(ctrl);
+	/* Anything still outstanding has no way to complete now. */
+	for (qi = 0; qi < NVME_MAX_IO_QUEUES; qi++) {
+		nvme_queue_flush_inflight(&ctrl->io_q[qi], BIO_STATUS_NODEV);
+	}
+	nvme_queue_flush_inflight(&ctrl->admin_q, BIO_STATUS_NODEV);
+	for (index = 0; index < NVME_MAX_CONTROLLERS; index++) {
+		if (nvme_ctrls[index] == ctrl) {
+			nvme_ctrls[index] = NULL;
+		}
+	}
+	pdev->driver_data = NULL;
+	nvme_ctrl_free(ctrl);
+}
+
+static const pci_match_t nvme_matches[] = {
+	{ PCI_ANY_ID, PCI_ANY_ID, NVME_PCI_CLASS, NVME_PCI_SUBCLASS,
+	    NVME_PCI_PROGIF },
+};
+
+static pci_driver_t nvme_pci_driver = {
+	.name		= NVME_DRIVER_NAME,
+	.matches	= nvme_matches,
+	.match_count	= 1,
+	.probe		= nvme_pci_probe,
+	.remove		= nvme_pci_remove,
+};
+
+static devclass_t nvme_devclass = {
+	.name		= NVME_DRIVER_NAME,
+	.maxunit	= NVME_MAX_CONTROLLERS,
+};
+
+PCI_DRIVER_MODULE(nvme, nvme_pci_driver, nvme_devclass,
+    NEWBUS_PASS_STORAGE, NEWBUS_ORDER_EARLY);
