+#define	KS_MAX_PINS_PER_DEVICE	32
+#define	KS_MAX_NODES_PER_DEVICE	64
+
+#define	KS_OBJ_FLAG_VALID	0x00000001
+#define	KS_OBJ_FLAG_PUBLIC	0x00000002
+
+typedef struct ks_object ks_object_t;
