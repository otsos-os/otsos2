+
+	(void)maxsegs;
+	if (mp == NULL || handle == NULL || segs == NULL || nsegs == NULL) {
+		return (PC_FAILURE_NOT_SUPPORTED);
+	}
+	sc = (hda_softc_t *)mp->device_ctx;
+	stream = (hda_stream_t *)handle;
